# ===============================================
#  iDempiere 10 — Entorno aislado (direnv + zsh)
#  V6 final: HOME + REPOSITORY, doctor corregido,
#  Maven aislado y Eclipse sin headless global
# ===============================================

# --- Raíz del entorno ---
export BASE="$(expand_path .)"
export IDEM10_ROOT="$BASE"

# --- Rutas principales ---
export SOURCES_DIR="$BASE/sources"
export IDEMPIERE_HOME="$SOURCES_DIR/idempiere"
export IDEMPIERE_REPOSITORY="$IDEMPIERE_HOME"
export ECLIPSE_HOME="$BASE/eclipse"
export ECLIPSE_WORKSPACE="$BASE/workspace-10"

# --- Maven local del entorno ---
export MAVEN_HOME="$BASE/apache-maven-3.6.3"
export M2_HOME="$MAVEN_HOME"
export MVN_LOCAL_REPO="$BASE/.m2/repository"
export MAVEN_USER_SETTINGS="$BASE/.m2/settings.xml"

# --- P2/Eclipse local (evita ensuciar ~/.p2) ---
export ECLIPSE_P2="$BASE/.p2"

# --- Directorio para scripts auxiliares ---
export BIN_DIR="$BASE/.local-bin"

# --- Branch esperado ---
export IDEMPIERE_BRANCH_EXPECTED="release-10"

# --- Java 11 (autodetección) ---
JAVA_CANDIDATES=(
  "/usr/lib/jvm/java-11-openjdk-amd64"
  "/usr/lib/jvm/java-1.11.0-openjdk-amd64"
  "/usr/lib/jvm/openjdk-11"
)
unset JAVA_HOME
for j in "${JAVA_CANDIDATES[@]}"; do
  if [[ -x "$j/bin/java" ]]; then
    export JAVA_HOME="$j"
    break
  fi
done
if [[ -z "${JAVA_HOME:-}" ]]; then
  echo "❌ No se encontró Java 11. Instala con: sudo apt install -y openjdk-11-jdk"
  return 1 2>/dev/null || exit 1
fi

# --- PATH_add fallback (por si se evalúa fuera de direnv) ---
if ! command -v PATH_add >/dev/null 2>&1; then
  PATH_add() { export PATH="$1:$PATH"; }
fi

# --- Estructura mínima real del entorno ---
mkdir -p \
  "$MVN_LOCAL_REPO" \
  "$BASE/.mvn" \
  "$ECLIPSE_WORKSPACE" \
  "$SOURCES_DIR" \
  "$ECLIPSE_P2" \
  "$BIN_DIR"

# --- settings.xml local (si no existe) ---
if [[ ! -f "$MAVEN_USER_SETTINGS" ]]; then
  cat >"$MAVEN_USER_SETTINGS" <<EOF
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <localRepository>$MVN_LOCAL_REPO</localRepository>
</settings>
EOF
fi

# --- maven.config local ---
_MVN_CFG="-s \"$MAVEN_USER_SETTINGS\"
\"-Dmaven.repo.local=$MVN_LOCAL_REPO\""
printf "%s\n" "$_MVN_CFG" > "$BASE/.mvn/maven.config"

# --- Flags Maven idempotentes ---
_managed_maven_opt="-Dmaven.repo.local=$MVN_LOCAL_REPO"
_maven_opts=" ${MAVEN_OPTS:-} "
while [[ "$_maven_opts" == *" $_managed_maven_opt "* ]]; do
  _maven_opts="${_maven_opts/ $_managed_maven_opt / }"
done
_maven_opts="${_maven_opts# }"
_maven_opts="${_maven_opts% }"
export MAVEN_OPTS="${_maven_opts:+$_maven_opts }$_managed_maven_opt"
unset _maven_opts _managed_maven_opt

# --- Scripts auxiliares ---
cat > "$BIN_DIR/mvn10" <<'EOF'
#!/bin/bash
set -euo pipefail
if [[ ! -x "$MAVEN_HOME/bin/mvn" ]]; then
  echo "❌ No existe Maven en $MAVEN_HOME/bin/mvn"
  exit 1
fi
exec env JAVA_TOOL_OPTIONS="-Djava.awt.headless=true ${JAVA_TOOL_OPTIONS:-}" \
  "$MAVEN_HOME/bin/mvn" \
  -s "$MAVEN_USER_SETTINGS" \
  -Dmaven.repo.local="$MVN_LOCAL_REPO" \
  "$@"
EOF

cat > "$BIN_DIR/eclipse-start" <<'EOF'
#!/bin/bash
set -euo pipefail
if [[ ! -x "$ECLIPSE_HOME/eclipse" ]]; then
  echo "❌ No existe el ejecutable de Eclipse en $ECLIPSE_HOME/eclipse"
  exit 1
fi
exec env GDK_BACKEND=x11 \
  "$ECLIPSE_HOME/eclipse" \
  -vm "$JAVA_HOME/bin/java" \
  -data "$ECLIPSE_WORKSPACE" \
  -configuration "$ECLIPSE_P2/configuration" \
  -consoleLog
EOF

cat > "$BIN_DIR/eclipse-choose" <<'EOF'
#!/bin/bash
set -euo pipefail
if [[ ! -x "$ECLIPSE_HOME/eclipse" ]]; then
  echo "❌ No existe el ejecutable de Eclipse en $ECLIPSE_HOME/eclipse"
  exit 1
fi
exec env GDK_BACKEND=x11 \
  "$ECLIPSE_HOME/eclipse" \
  -vm "$JAVA_HOME/bin/java" \
  -data @noDefault \
  -configuration "$ECLIPSE_P2/configuration" \
  -Dosgi.instance.area.default="$ECLIPSE_WORKSPACE" \
  -consoleLog
EOF

cat > "$BIN_DIR/idempiere-root" <<'EOF'
#!/bin/bash
set -euo pipefail
if [[ ! -d "$IDEMPIERE_REPOSITORY" ]]; then
  echo "❌ No existe $IDEMPIERE_REPOSITORY"
  exit 1
fi
cd "$IDEMPIERE_REPOSITORY"
exec "${SHELL:-/bin/bash}"
EOF

cat > "$BIN_DIR/idempiere-clone" <<'EOF'
#!/bin/bash
set -euo pipefail
if [[ -e "$IDEMPIERE_REPOSITORY/.git" || -f "$IDEMPIERE_REPOSITORY/pom.xml" ]]; then
  echo "Repo ya presente en $IDEMPIERE_REPOSITORY"
  exit 0
fi
if [[ -e "$IDEMPIERE_REPOSITORY" ]] && [[ -n "$(ls -A "$IDEMPIERE_REPOSITORY" 2>/dev/null || true)" ]]; then
  echo "❌ $IDEMPIERE_REPOSITORY existe y no está vacío."
  echo "   No se clonará encima para evitar pérdida de datos."
  exit 1
fi
if ! command -v git >/dev/null 2>&1; then
  echo "❌ git no está disponible en PATH"
  exit 1
fi
mkdir -p "$SOURCES_DIR"
git clone --branch "$IDEMPIERE_BRANCH_EXPECTED" https://github.com/idempiere/idempiere.git "$IDEMPIERE_REPOSITORY"
branch="$(git -C "$IDEMPIERE_REPOSITORY" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
echo "Branch actual: ${branch:-desconocido}"
if [[ -n "$branch" && "$branch" != "$IDEMPIERE_BRANCH_EXPECTED" ]]; then
  echo "⚠️  Se esperaba $IDEMPIERE_BRANCH_EXPECTED pero quedó $branch"
fi
EOF

cat > "$BIN_DIR/idempiere-fix-maven-config" <<'EOF'
#!/bin/bash
set -euo pipefail
if [[ ! -d "$IDEMPIERE_REPOSITORY" ]]; then
  echo "❌ No existe el repo en $IDEMPIERE_REPOSITORY"
  exit 1
fi
mkdir -p "$IDEMPIERE_REPOSITORY/.mvn"
cat > "$IDEMPIERE_REPOSITORY/.mvn/maven.config" <<CFG
-s "$MAVEN_USER_SETTINGS"
"-Dmaven.repo.local=$MVN_LOCAL_REPO"
CFG
echo "✅ Regenerado: $IDEMPIERE_REPOSITORY/.mvn/maven.config"
EOF

cat > "$BIN_DIR/idempiere-doctor" <<'EOF'
#!/bin/bash
set -uo pipefail

section() { printf "\n%s\n%s\n" "$1" "$(printf '%*s' ${#1} '' | tr ' ' '-')"; }
ok()      { printf "✅ %s\n" "$1"; }
warn()    { printf "⚠️  %s\n" "$1"; }
fail()    { printf "❌ %s\n" "$1"; }
info()    { printf "ℹ️  %s\n" "$1"; }
value()   { printf "   • %-20s %s\n" "$1" "$2"; }

DOCTOR_FAILURES=0
DOCTOR_WARNS=0

note_ok()   { ok "$1"; }
note_warn() { warn "$1"; DOCTOR_WARNS=$((DOCTOR_WARNS+1)); }
note_fail() { fail "$1"; DOCTOR_FAILURES=$((DOCTOR_FAILURES+1)); }

get_java_major() {
  "$JAVA_HOME/bin/java" -version 2>&1 | awk -F '[\".]' '/version/ { if ($2 == "1") print $3; else print $2; exit }'
}

get_maven_java_major() {
  "$MAVEN_HOME/bin/mvn" -v 2>/dev/null | awk -F '[ .]+' '/Java version:/ {print $3; exit}'
}

find_tycho_version() {
  local ver=""
  if [[ -f "$IDEMPIERE_REPOSITORY/.mvn/extensions.xml" ]]; then
    ver=$(grep -oPm1 '(?<=<version>)[^<]+' "$IDEMPIERE_REPOSITORY/.mvn/extensions.xml" 2>/dev/null || true)
  fi
  for pom in "$IDEMPIERE_REPOSITORY/org.idempiere.parent/pom.xml" "$IDEMPIERE_REPOSITORY/pom.xml"; do
    if [[ -z "$ver" && -f "$pom" ]]; then
      ver=$(grep -oPm1 '(?<=<tycho.version>)[^<]+' "$pom" 2>/dev/null || true)
    fi
  done
  printf "%s" "$ver"
}

get_project_version() {
  local pom="" ver=""
  for pom in "$IDEMPIERE_REPOSITORY/org.idempiere.parent/pom.xml" "$IDEMPIERE_REPOSITORY/pom.xml"; do
    if [[ -f "$pom" ]]; then
      ver=$(grep -oPm1 '(?<=<revision>)[^<]+' "$pom" 2>/dev/null || true)
      [[ -n "$ver" ]] && break
    fi
  done
  printf "%s" "$ver"
}

section "Doctor de entorno iDempiere 10"
info "Este chequeo revisa el entorno aislado y también señales básicas de coherencia del build para iDempiere 10."
info "No modifica archivos; sólo inspecciona rutas, binarios, configuración Maven y metadatos del repo."

section "1) Entorno base"
[[ -d "$IDEM10_ROOT" ]] && note_ok "La raíz del entorno existe: $IDEM10_ROOT" || note_fail "No existe la raíz del entorno: $IDEM10_ROOT"
[[ -x "$JAVA_HOME/bin/java" ]] && note_ok "JAVA_HOME apunta a un Java ejecutable" || note_fail "JAVA_HOME es inválido: $JAVA_HOME"
[[ -x "$MAVEN_HOME/bin/mvn" ]] && note_ok "Maven del entorno está presente" || note_fail "No encuentro Maven en $MAVEN_HOME/bin/mvn"
[[ -f "$MAVEN_USER_SETTINGS" ]] && note_ok "settings.xml local presente" || note_fail "Falta settings.xml local: $MAVEN_USER_SETTINGS"
[[ -d "$MVN_LOCAL_REPO" ]] && note_ok "Repositorio Maven local presente" || note_fail "Falta el repo Maven local: $MVN_LOCAL_REPO"
[[ -d "$SOURCES_DIR" ]] && note_ok "Carpeta sources presente" || note_fail "Falta la carpeta sources: $SOURCES_DIR"
[[ -d "$ECLIPSE_WORKSPACE" ]] && note_ok "Workspace local presente" || note_fail "Falta workspace: $ECLIPSE_WORKSPACE"
[[ -d "$ECLIPSE_P2" ]] && note_ok ".p2 local presente" || note_fail "Falta .p2 local: $ECLIPSE_P2"
[[ -d "$BIN_DIR" ]] && note_ok "Carpeta de wrappers presente" || note_fail "Falta BIN_DIR: $BIN_DIR"
[[ -x "$ECLIPSE_HOME/eclipse" ]] && note_ok "Eclipse está instalado en el entorno" || note_warn "No encuentro Eclipse en $ECLIPSE_HOME/eclipse"
command -v git >/dev/null 2>&1 && note_ok "git está disponible en PATH" || note_fail "git no está disponible en PATH"
command -v curl >/dev/null 2>&1 && note_ok "curl está disponible para probar conectividad" || note_warn "curl no está en PATH; omitiré chequeo de red"
command -v mvn10 >/dev/null 2>&1 && note_ok "wrapper mvn10 disponible" || note_fail "mvn10 no está en PATH"

section "2) Variables principales"
value "IDEM10_ROOT" "$IDEM10_ROOT"
value "IDEMPIERE_HOME" "$IDEMPIERE_HOME"
value "IDEMPIERE_REPOSITORY" "$IDEMPIERE_REPOSITORY"
value "SOURCES_DIR" "$SOURCES_DIR"
value "ECLIPSE_HOME" "$ECLIPSE_HOME"
value "ECLIPSE_WORKSPACE" "$ECLIPSE_WORKSPACE"

section "3) Versiones activas"
JAVA_MAJOR=""
MAVEN_JAVA_MAJOR=""
if [[ -x "$JAVA_HOME/bin/java" ]]; then
  JAVA_MAJOR="$(get_java_major 2>/dev/null || true)"
  value "JAVA_HOME" "$JAVA_HOME"
  value "Java major" "${JAVA_MAJOR:-desconocido}"
  "$JAVA_HOME/bin/java" -version 2>&1 | sed 's/^/   • /'
fi
if [[ -x "$MAVEN_HOME/bin/mvn" ]]; then
  value "MAVEN_HOME" "$MAVEN_HOME"
  "$MAVEN_HOME/bin/mvn" -v 2>&1 | sed 's/^/   • /'
  MAVEN_JAVA_MAJOR="$(get_maven_java_major 2>/dev/null || true)"
  [[ -n "$MAVEN_JAVA_MAJOR" ]] && value "Maven usa Java" "$MAVEN_JAVA_MAJOR"
fi

section "4) Repo iDempiere"
if [[ -f "$IDEMPIERE_REPOSITORY/pom.xml" || -d "$IDEMPIERE_REPOSITORY/.git" ]]; then
  note_ok "Repo iDempiere detectado en $IDEMPIERE_REPOSITORY"
else
  note_warn "No encuentro un repo iDempiere clonado en $IDEMPIERE_REPOSITORY"
  info "Puedes clonar la rama esperada con: idempiere-clone"
fi

if [[ -d "$IDEMPIERE_REPOSITORY/.git" ]]; then
  BRANCH="$(git -C "$IDEMPIERE_REPOSITORY" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
  [[ -n "$BRANCH" ]] && value "Branch actual" "$BRANCH"
  if [[ -n "$BRANCH" && "$BRANCH" == "$IDEMPIERE_BRANCH_EXPECTED" ]]; then
    note_ok "La rama activa coincide con la esperada: $IDEMPIERE_BRANCH_EXPECTED"
  elif [[ -n "$BRANCH" ]]; then
    note_warn "La rama activa es $BRANCH y la esperada para este entorno es $IDEMPIERE_BRANCH_EXPECTED"
  fi
fi

if [[ -f "$IDEMPIERE_REPOSITORY/.mvn/maven.config" ]]; then
  note_ok "El repo tiene .mvn/maven.config local"
  info "Ese archivo ayuda a que Maven dentro del repo use el settings.xml y el repositorio local del entorno."
else
  note_warn "Falta $IDEMPIERE_REPOSITORY/.mvn/maven.config"
  info "Puedes regenerarlo con: idempiere-fix-maven-config"
fi

if [[ -f "$IDEMPIERE_REPOSITORY/.mvn/extensions.xml" ]]; then
  note_ok "El repo define extensiones Maven en .mvn/extensions.xml"
else
  note_warn "No veo .mvn/extensions.xml en el repo"
fi

if [[ -d "$IDEMPIERE_REPOSITORY/org.idempiere.p2.targetplatform" ]]; then
  note_ok "Existe el módulo org.idempiere.p2.targetplatform"
else
  note_warn "No encuentro el módulo org.idempiere.p2.targetplatform"
fi

section "5) Datos de build"
TYCHO_VERSION=""
PROJECT_VERSION=""
if [[ -d "$IDEMPIERE_REPOSITORY" ]]; then
  TYCHO_VERSION="$(find_tycho_version)"
  PROJECT_VERSION="$(get_project_version || true)"
fi

if [[ -n "$TYCHO_VERSION" ]]; then
  value "Tycho detectado" "$TYCHO_VERSION"
  note_ok "Pude detectar una versión de Tycho en el repo"
else
  note_warn "No pude detectar claramente la versión de Tycho"
fi

if [[ -n "$PROJECT_VERSION" ]]; then
  value "project.version" "$PROJECT_VERSION"
  if [[ "$PROJECT_VERSION" == *-SNAPSHOT ]]; then
    note_ok "El repo reporta una versión SNAPSHOT"
  else
    note_warn "El repo reporta una versión release ($PROJECT_VERSION), no SNAPSHOT"
  fi
else
  note_warn "No pude detectar la propiedad revision en los POM"
fi

section "6) Compatibilidad esperada"
if [[ -n "$TYCHO_VERSION" && -n "$JAVA_MAJOR" ]]; then
  TYCHO_MAJOR="${TYCHO_VERSION%%.*}"
  if [[ "$TYCHO_MAJOR" =~ ^[0-9]+$ ]]; then
    if (( TYCHO_MAJOR >= 4 )) && (( JAVA_MAJOR < 17 )); then
      note_fail "Tycho $TYCHO_VERSION normalmente requiere Java 17 para ejecutar Maven/Tycho, pero este entorno está cargando Java $JAVA_MAJOR"
      info "Ese patrón coincide con errores tipo UnsupportedClassVersionError class file version 61 vs 55."
    elif (( TYCHO_MAJOR >= 4 )) && (( JAVA_MAJOR >= 17 )); then
      note_ok "Tycho $TYCHO_VERSION y Java $JAVA_MAJOR parecen compatibles para ejecutar Maven/Tycho"
    elif (( TYCHO_MAJOR < 4 )) && (( JAVA_MAJOR == 11 )); then
      note_ok "Tycho $TYCHO_VERSION con Java 11 encaja con un entorno clásico de iDempiere 10"
    elif (( TYCHO_MAJOR < 4 )) && (( JAVA_MAJOR > 11 )); then
      note_warn "Tycho $TYCHO_VERSION es antiguo y estás usando Java $JAVA_MAJOR; puede funcionar o no, depende del repo y sus dependencias"
    fi
  fi
else
  note_warn "No tengo suficientes datos para evaluar compatibilidad Java/Tycho"
fi

if command -v curl >/dev/null 2>&1; then
  if curl -Is --max-time 5 https://github.com >/dev/null 2>&1; then
    note_ok "Hay conectividad básica a GitHub"
  else
    note_warn "No pude verificar conectividad a GitHub"
  fi
fi

section "7) Lectura rápida"
if (( DOCTOR_FAILURES == 0 && DOCTOR_WARNS == 0 )); then
  ok "Todo se ve consistente para trabajar con este entorno."
elif (( DOCTOR_FAILURES == 0 && DOCTOR_WARNS > 0 )); then
  warn "El entorno está usable, pero hay puntos a revisar antes de confiar en el build."
else
  fail "Hay problemas importantes en el entorno o en la coherencia del build."
fi

value "Fallos" "$DOCTOR_FAILURES"
value "Avisos" "$DOCTOR_WARNS"

if (( DOCTOR_FAILURES > 0 )); then
  info "Empieza corrigiendo los fallos rojos; suelen bloquear Eclipse, Maven o el clone del repo."
fi
if (( DOCTOR_WARNS > 0 )); then
  info "Después revisa los avisos amarillos; suelen explicar incoherencias de rama, versionado o configuración Maven dentro del repo."
fi

section "8) Comandos útiles"
info "mvn10 clean verify          -> ejecuta Maven del entorno con repo local aislado y headless sólo para Maven"
info "idempiere-clone            -> clona release-10 en sources/idempiere"
info "idempiere-fix-maven-config -> regenera .mvn/maven.config dentro del repo"
info "eclipse-start              -> abre Eclipse con workspace y .p2 del entorno"

(( DOCTOR_FAILURES == 0 )) || exit 1
EOF

chmod +x \
  "$BIN_DIR/mvn10" \
  "$BIN_DIR/eclipse-start" \
  "$BIN_DIR/eclipse-choose" \
  "$BIN_DIR/idempiere-root" \
  "$BIN_DIR/idempiere-clone" \
  "$BIN_DIR/idempiere-fix-maven-config" \
  "$BIN_DIR/idempiere-doctor"

# --- PATH ---
PATH_add "$ECLIPSE_HOME"
PATH_add "$MAVEN_HOME/bin"
PATH_add "$JAVA_HOME/bin"
PATH_add "$BIN_DIR"

# ==========================
#  Validaciones de arranque
# ==========================
_warns=()
[[ -x "$MAVEN_HOME/bin/mvn" ]] || _warns+=("Maven no encontrado en $MAVEN_HOME/bin/mvn")
[[ -x "$ECLIPSE_HOME/eclipse" ]] || _warns+=("Eclipse no encontrado en $ECLIPSE_HOME/eclipse")
command -v git >/dev/null 2>&1 || _warns+=("git no está en PATH")
[[ -d "$SOURCES_DIR" ]] || _warns+=("Sources no existe: $SOURCES_DIR")

# ==========================
#  Panel visual de estado
# ==========================
if [[ -t 1 && -n "${TERM:-}" ]] && command -v tput >/dev/null 2>&1 && tput colors >/dev/null 2>&1; then
  _bold=$(tput bold); _dim=$(tput dim); _reset=$(tput sgr0)
  _c1=$(tput setaf 6); _c2=$(tput setaf 2); _c3=$(tput setaf 5); _c4=$(tput setaf 4); _cY=$(tput setaf 3); _cR=$(tput setaf 1)
else
  _bold=''; _dim=''; _reset=''; _c1=''; _c2=''; _c3=''; _c4=''; _cY=''; _cR=''
fi

_print_kv () { printf "  ${_bold}%-16s${_reset} %s\n" "$1" "$2"; }

if [[ -f "$IDEMPIERE_REPOSITORY/pom.xml" || -d "$IDEMPIERE_REPOSITORY/.git" ]]; then
  _repo_status="${_c2}OK${_reset}"
else
  _repo_status="${_cY}pendiente de clonar en $IDEMPIERE_REPOSITORY${_reset}"
fi

if [[ -x "$ECLIPSE_HOME/eclipse" ]]; then
  _eclipse_status="${_c2}OK${_reset}"
else
  _eclipse_status="${_cR}faltante${_reset}"
fi

if [[ -x "$MAVEN_HOME/bin/mvn" ]]; then
  _maven_status="${_c2}OK${_reset}"
else
  _maven_status="${_cR}faltante${_reset}"
fi

if command -v git >/dev/null 2>&1; then
  _git_status="${_c2}OK${_reset}"
else
  _git_status="${_cR}faltante${_reset}"
fi

hr_top="┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓"
hr_mid="┣━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┫"
hr_bot="┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛"

echo ""
echo "${_c1}${hr_top}${_reset}"
printf "┃ ${_bold}iDempiere 10 — Entorno cargado${_reset} %-21s ┃\n" ""
echo "${_c1}${hr_mid}${_reset}"
_print_kv "JAVA_HOME"          "${_c2}$JAVA_HOME${_reset}"
_print_kv "MAVEN_HOME"         "${_c2}$MAVEN_HOME${_reset}"
_print_kv "Maven status"       "$_maven_status"
_print_kv "Repo Maven"         "${_c3}$MVN_LOCAL_REPO${_reset}"
_print_kv "Settings.xml"       "${_c3}$MAVEN_USER_SETTINGS${_reset}"
_print_kv "Eclipse"            "${_c4}$ECLIPSE_HOME${_reset}"
_print_kv "Eclipse status"     "$_eclipse_status"
_print_kv "Workspace"          "${_c4}$ECLIPSE_WORKSPACE${_reset}"
_print_kv "Sources"            "${_cY}$SOURCES_DIR${_reset}"
_print_kv "IDEMPIERE_HOME"     "${_cY}$IDEMPIERE_HOME${_reset}"
_print_kv "IDEMPIERE_REPO"     "${_cY}$IDEMPIERE_REPOSITORY${_reset}"
_print_kv "Repo estado"        "$_repo_status"
_print_kv "Git status"         "$_git_status"
_print_kv "Branch esperado"    "${_cY}$IDEMPIERE_BRANCH_EXPECTED${_reset}"
_print_kv "Eclipse p2"         "${_c4}$ECLIPSE_P2${_reset}"
echo "${_c1}${hr_bot}${_reset}"
echo "💡 ${_dim}Comandos:${_reset} ${_bold}mvn10${_reset} | ${_bold}eclipse-start${_reset} | ${_bold}eclipse-choose${_reset} | ${_bold}idempiere-root${_reset} | ${_bold}idempiere-clone${_reset} | ${_bold}idempiere-fix-maven-config${_reset} | ${_bold}idempiere-doctor${_reset}"

if [[ ${#_warns[@]} -gt 0 ]]; then
  echo ""
  echo "${_cY}${_bold}Avisos:${_reset}"
  for w in "${_warns[@]}"; do
    printf "  ${_cY}- %s${_reset}\n" "$w"
  done
fi

echo ""
