cat > "$IDEMPIERE_MAN_ROOT/es/man1/idempiere-sync-upstream.1" <<'EOF'
.TH IDEMPIERE-SYNC-UPSTREAM 1 "2026-10-06" "iDempiere 13" "Comandos locales"
.SH NOMBRE
idempiere-sync-upstream
.SH SINOPSIS
idempiere-sync-upstream
