# ==============================================================
# iDempiere 13 — Entorno aislado de desarrollo/contribución
# direnv + zsh/bash | Java 17 | Maven Wrapper oficial
#
# Git:
#   modo official -> origin = repositorio oficial
#   modo fork     -> origin = fork personal; upstream = repositorio oficial
# ==============================================================

# --- Raíz del entorno ---
export BASE="$(expand_path .)"
export IDEM13_ROOT="$BASE"
export IDEMPIERE_OS="$(uname -s)"
export IDEMPIERE_JAVA_MAJOR_EXPECTED="17"

case "$IDEMPIERE_OS" in
  Linux|Darwin) ;;
  *)
    echo "❌ Sistema no compatible: $IDEMPIERE_OS"
    return 1 2>/dev/null || exit 1
    ;;
esac

# --- Rutas principales ---
export SOURCES_DIR="$BASE/sources"
export IDEMPIERE_HOME="$SOURCES_DIR/idempiere"
export IDEMPIERE_REPOSITORY="$IDEMPIERE_HOME"
export ECLIPSE_HOME="$BASE/eclipse"
export ECLIPSE_WORKSPACE="$BASE/workspace-13"
if [[ "$IDEMPIERE_OS" == "Darwin" ]]; then
  export ECLIPSE_EXECUTABLE="$ECLIPSE_HOME/Eclipse.app/Contents/MacOS/eclipse"
else
  export ECLIPSE_EXECUTABLE="$ECLIPSE_HOME/eclipse"
fi

# --- Git / colaboración ---
export IDEMPIERE_BRANCH_EXPECTED="release-13"
export IDEMPIERE_OFFICIAL_URL="https://github.com/idempiere/idempiere.git"
export IDEMPIERE_GIT_CONFIG="$BASE/.idempiere-git.env"
if command -v watch_file >/dev/null 2>&1; then
  watch_file "$IDEMPIERE_GIT_CONFIG"
fi

# Configuración persistente declarativa. Se analiza sin ejecutar código shell.
_git_mode="unconfigured"
_git_origin=""
_git_upstream=""
_git_config_error=""

if [[ -f "$IDEMPIERE_GIT_CONFIG" ]]; then
  while IFS= read -r _git_line || [[ -n "$_git_line" ]]; do
    [[ -z "$_git_line" || "$_git_line" == \#* ]] && continue
    _git_line="${_git_line#export }"
    if [[ "$_git_line" != *=* ]]; then
      _git_config_error="línea sin formato clave=valor"
      break
    fi
    _git_key="${_git_line%%=*}"
    _git_value="${_git_line#*=}"
    if [[ "$_git_value" == \"*\" && "$_git_value" == *\" ]]; then
      _git_value="${_git_value:1:${#_git_value}-2}"
    elif [[ "$_git_value" == \'*\' && "$_git_value" == *\' ]]; then
      _git_value="${_git_value:1:${#_git_value}-2}"
    fi
    case "$_git_key" in
      IDEMPIERE_GIT_MODE) _git_mode="$_git_value" ;;
      IDEMPIERE_ORIGIN_URL) _git_origin="$_git_value" ;;
      IDEMPIERE_UPSTREAM_URL) _git_upstream="$_git_value" ;;
      *) _git_config_error="clave no permitida: $_git_key"; break ;;
    esac
  done < "$IDEMPIERE_GIT_CONFIG"

  if [[ -z "$_git_config_error" ]]; then
    case "$_git_mode" in
      official)
        [[ "$_git_origin" == "$IDEMPIERE_OFFICIAL_URL" ]] || _git_config_error="origin no es el repositorio oficial"
        [[ -z "$_git_upstream" ]] || _git_config_error="upstream debe estar vacío en modo official"
        ;;
      fork)
        [[ -n "$_git_origin" ]] || _git_config_error="falta la URL del fork"
        case "$_git_origin" in
          https://*|http://*|ssh://*|git@*:*) ;;
          *) _git_config_error="URL del fork no válida" ;;
        esac
        [[ "$_git_origin" != *[$'\r\n\t ']* ]] || _git_config_error="la URL del fork contiene espacios o controles"
        [[ "$_git_upstream" == "$IDEMPIERE_OFFICIAL_URL" ]] || _git_config_error="upstream no es el repositorio oficial"
        ;;
      *) _git_config_error="modo Git no válido: $_git_mode" ;;
    esac
  fi
fi

if [[ -n "$_git_config_error" ]]; then
  _git_mode="unconfigured"
  _git_origin=""
  _git_upstream=""
fi

export IDEMPIERE_GIT_MODE="$_git_mode"
export IDEMPIERE_ORIGIN_URL="$_git_origin"
export IDEMPIERE_UPSTREAM_URL="$_git_upstream"
export IDEMPIERE_GIT_CONFIG_ERROR="$_git_config_error"
unset _git_mode _git_origin _git_upstream _git_config_error _git_line _git_key _git_value

# --- Maven completamente aislado ---
# iDempiere 13 trae Maven Wrapper y release-13 fija Maven 3.9.10.
# MAVEN_USER_HOME mantiene también wrapper/dists dentro de este entorno.
export MAVEN_USER_HOME="$BASE/.m2"
export MVN_LOCAL_REPO="$MAVEN_USER_HOME/repository"
export MAVEN_USER_SETTINGS="$MAVEN_USER_HOME/settings.xml"

# Compatibilidad con herramientas/scripts que consulten M2_HOME/MAVEN_HOME.
# No se define MAVEN_HOME: para iDempiere 13 se usa ./mvnw.
unset MAVEN_HOME
unset M2_HOME

# --- P2/Eclipse local (evita ensuciar ~/.p2) ---
export ECLIPSE_P2="$BASE/.p2"

# --- Directorio para scripts auxiliares ---
export BIN_DIR="$BASE/.local-bin"

# --- Java 17 (Linux/macOS; requisito de release-13) ---
JAVA_CANDIDATES=()
[[ -n "${IDEMPIERE_JAVA_HOME_OVERRIDE:-}" ]] && JAVA_CANDIDATES+=("$IDEMPIERE_JAVA_HOME_OVERRIDE")
if [[ "$IDEMPIERE_OS" == "Darwin" ]]; then
  _mac_java_home="$(/usr/libexec/java_home -v "$IDEMPIERE_JAVA_MAJOR_EXPECTED" 2>/dev/null || true)"
  [[ -n "$_mac_java_home" ]] && JAVA_CANDIDATES+=("$_mac_java_home")
else
  JAVA_CANDIDATES+=(
    "/usr/lib/jvm/java-17-openjdk-amd64"
    "/usr/lib/jvm/java-1.17.0-openjdk-amd64"
    "/usr/lib/jvm/openjdk-17"
  )
fi

unset JAVA_HOME
for j in "${JAVA_CANDIDATES[@]}"; do
  [[ -x "$j/bin/java" ]] || continue
  _java_major="$("$j/bin/java" -version 2>&1 | awk -F '[\".]' '/version/ { if ($2 == "1") print $3; else print $2; exit }' || true)"
  if [[ "$_java_major" == "$IDEMPIERE_JAVA_MAJOR_EXPECTED" ]]; then
    export JAVA_HOME="$j"
    break
  fi
done
unset _mac_java_home _java_major j

if [[ -z "${JAVA_HOME:-}" ]]; then
  echo "❌ No se encontró Java 17 compatible en $IDEMPIERE_OS."
  if [[ "$IDEMPIERE_OS" == "Darwin" ]]; then
    echo "   Instala un JDK 17 y comprueba: /usr/libexec/java_home -V"
  else
    echo "   Instala en Pop!_OS/Ubuntu con: sudo apt install -y openjdk-17-jdk"
  fi
  return 1 2>/dev/null || exit 1
fi

# --- PATH_add fallback (por si se evalúa fuera de direnv) ---
if ! command -v PATH_add >/dev/null 2>&1; then
  PATH_add() { export PATH="$1:$PATH"; }
fi

# --- Estructura mínima del entorno ---
mkdir -p \
  "$MVN_LOCAL_REPO" \
  "$ECLIPSE_WORKSPACE" \
  "$SOURCES_DIR" \
  "$ECLIPSE_P2" \
  "$BIN_DIR"

# --- settings.xml Maven local ---
if [[ ! -f "$MAVEN_USER_SETTINGS" ]]; then
  cat >"$MAVEN_USER_SETTINGS" <<EOF
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <localRepository>$MVN_LOCAL_REPO</localRepository>
</settings>
EOF
fi

# --- Flags Maven idempotentes ---
_managed_maven_opt="-Dmaven.repo.local=$MVN_LOCAL_REPO"
_maven_opts=" ${MAVEN_OPTS:-} "
while [[ "$_maven_opts" == *" $_managed_maven_opt "* ]]; do
  _maven_opts="${_maven_opts/ $_managed_maven_opt / }"
done
_maven_opts="${_maven_opts# }"
_maven_opts="${_maven_opts% }"
export MAVEN_OPTS="${_maven_opts:+$_maven_opts }$_managed_maven_opt"
unset _maven_opts _managed_maven_opt

# ==============================================================
# Wrappers auxiliares
# ==============================================================

# mvn13: usa SIEMPRE el Maven Wrapper que viene con release-13.
cat > "$BIN_DIR/mvn13" <<'EOF'
#!/bin/bash
set -euo pipefail

if [[ ! -x "$IDEMPIERE_REPOSITORY/mvnw" ]]; then
  echo "❌ No existe $IDEMPIERE_REPOSITORY/mvnw"
  echo "   Primero ejecuta: idempiere-clone"
  exit 1
fi

cd "$IDEMPIERE_REPOSITORY"

exec env \
  JAVA_HOME="$JAVA_HOME" \
  MAVEN_USER_HOME="$MAVEN_USER_HOME" \
  JAVA_TOOL_OPTIONS="-Djava.awt.headless=true ${JAVA_TOOL_OPTIONS:-}" \
  ./mvnw \
  -s "$MAVEN_USER_SETTINGS" \
  -Dmaven.repo.local="$MVN_LOCAL_REPO" \
  "$@"
EOF

cat > "$BIN_DIR/eclipse-start" <<'EOF'
#!/bin/bash
set -euo pipefail

if [[ ! -x "$ECLIPSE_EXECUTABLE" ]]; then
  echo "❌ No existe el ejecutable de Eclipse en $ECLIPSE_EXECUTABLE"
  exit 1
fi

if [[ "$IDEMPIERE_OS" == "Darwin" ]]; then unset GDK_BACKEND; else export GDK_BACKEND=x11; fi
exec \
  "$ECLIPSE_EXECUTABLE" \
  -vm "$JAVA_HOME/bin/java" \
  -data "$ECLIPSE_WORKSPACE" \
  -configuration "$ECLIPSE_P2/configuration" \
  -consoleLog
EOF

cat > "$BIN_DIR/eclipse-choose" <<'EOF'
#!/bin/bash
set -euo pipefail

if [[ ! -x "$ECLIPSE_EXECUTABLE" ]]; then
  echo "❌ No existe el ejecutable de Eclipse en $ECLIPSE_EXECUTABLE"
  exit 1
fi

if [[ "$IDEMPIERE_OS" == "Darwin" ]]; then unset GDK_BACKEND; else export GDK_BACKEND=x11; fi
exec \
  "$ECLIPSE_EXECUTABLE" \
  -vm "$JAVA_HOME/bin/java" \
  -data @noDefault \
  -configuration "$ECLIPSE_P2/configuration" \
  -Dosgi.instance.area.default="$ECLIPSE_WORKSPACE" \
  -consoleLog
EOF

cat > "$BIN_DIR/idempiere-root" <<'EOF'
#!/bin/bash
set -euo pipefail

if [[ ! -d "$IDEMPIERE_REPOSITORY" ]]; then
  echo "❌ No existe $IDEMPIERE_REPOSITORY"
  exit 1
fi

cd "$IDEMPIERE_REPOSITORY"
exec "${SHELL:-/bin/bash}"
EOF

cat > "$BIN_DIR/idempiere-clone" <<'EOF'
#!/bin/bash
set -euo pipefail

CONFIG_FILE="${IDEMPIERE_GIT_CONFIG:?}"
OFFICIAL_URL="${IDEMPIERE_OFFICIAL_URL:?}"
BRANCH="${IDEMPIERE_BRANCH_EXPECTED:?}"

save_config() {
  local mode="$1" origin="$2" upstream="$3"
  local tmp=""
  tmp="$(mktemp "${CONFIG_FILE}.tmp.XXXXXX")"
  chmod 600 "$tmp"
  {
    printf '%s\n' '# Generado por idempiere-clone. Puede editarse manualmente.'
    printf 'IDEMPIERE_GIT_MODE=%s\n' "$mode"
    printf 'IDEMPIERE_ORIGIN_URL=%s\n' "$origin"
    printf 'IDEMPIERE_UPSTREAM_URL=%s\n' "$upstream"
  } > "$tmp"
  mv "$tmp" "$CONFIG_FILE"
}

validate_git_url() {
  local url="$1"
  [[ -n "$url" && "$url" != *[$'\r\n\t ']* ]] || return 1
  case "$url" in
    https://*|http://*|ssh://*|git@*:*) return 0 ;;
    *) return 1 ;;
  esac
}

if [[ -d "$IDEMPIERE_REPOSITORY/.git" ]]; then
  echo "✅ Repo ya presente en $IDEMPIERE_REPOSITORY"
  ACTUAL_ORIGIN="$(git -C "$IDEMPIERE_REPOSITORY" remote get-url origin 2>/dev/null || true)"
  ACTUAL_UPSTREAM="$(git -C "$IDEMPIERE_REPOSITORY" remote get-url upstream 2>/dev/null || true)"
  case "${IDEMPIERE_GIT_MODE:-unconfigured}" in
    official)
      [[ "$ACTUAL_ORIGIN" == "$OFFICIAL_URL" ]] || { echo "❌ Origin no coincide con el repositorio oficial."; exit 1; }
      [[ -z "$ACTUAL_UPSTREAM" ]] || { echo "❌ Upstream no debe existir en modo official."; exit 1; }
      echo "   Origin (official)   -> $ACTUAL_ORIGIN"
      echo "   Upstream            -> n/a"
      ;;
    fork)
      [[ -n "${IDEMPIERE_ORIGIN_URL:-}" && "$ACTUAL_ORIGIN" == "$IDEMPIERE_ORIGIN_URL" ]] || { echo "❌ Origin no coincide con el fork persistido."; exit 1; }
      [[ "$ACTUAL_UPSTREAM" == "$OFFICIAL_URL" ]] || { echo "❌ Upstream no coincide con el repositorio oficial."; exit 1; }
      echo "   Origin (fork)       -> $ACTUAL_ORIGIN"
      echo "   Upstream (official) -> $ACTUAL_UPSTREAM"
      ;;
    *)
      echo "❌ El repositorio existe, pero la configuración Git no es válida."
      echo "   Corrige o elimina $CONFIG_FILE y vuelve a cargar direnv."
      exit 1
      ;;
  esac
  exit 0
fi

if [[ -e "$IDEMPIERE_REPOSITORY" ]] && [[ -n "$(ls -A "$IDEMPIERE_REPOSITORY" 2>/dev/null || true)" ]]; then
  echo "❌ $IDEMPIERE_REPOSITORY existe y no está vacío."
  echo "   No se clonará encima para evitar pérdida de datos."
  exit 1
fi

command -v git >/dev/null 2>&1 || { echo "❌ git no está disponible en PATH"; exit 1; }
mkdir -p "$SOURCES_DIR"

echo ""
echo "¿Qué repositorio quieres usar para este entorno?"
echo "  1) Repositorio oficial de iDempiere"
echo "     $OFFICIAL_URL"
echo "  2) Mi fork (recomendado si vas a contribuir mediante Pull Requests)"
echo ""
read -r -p "Selecciona [1/2]: " choice

case "$choice" in
  1|official|oficial)
    MODE="official"
    ORIGIN_URL="$OFFICIAL_URL"
    UPSTREAM_URL=""
    ;;
  2|fork)
    MODE="fork"
    echo ""
    read -r -p "URL Git de tu fork (SSH o HTTPS): " ORIGIN_URL
    if ! validate_git_url "$ORIGIN_URL"; then
      echo "❌ La URL del fork no es una URL Git SSH o HTTP(S) válida."
      exit 1
    fi
    UPSTREAM_URL="$OFFICIAL_URL"
    ;;
  *)
    echo "❌ Opción no válida."
    exit 1
    ;;
esac

echo ""
echo "▶ Clonando $ORIGIN_URL ($BRANCH)..."
git clone --origin origin --branch "$BRANCH" "$ORIGIN_URL" "$IDEMPIERE_REPOSITORY"
cd "$IDEMPIERE_REPOSITORY"

save_config "$MODE" "$ORIGIN_URL" "$UPSTREAM_URL"

if [[ "$MODE" == "fork" ]]; then
  echo "▶ Configurando upstream oficial..."
  git remote add upstream "$UPSTREAM_URL"
  git fetch upstream "$BRANCH"
  git branch --set-upstream-to="origin/$BRANCH" "$BRANCH" >/dev/null 2>&1 || true
else
  git branch --set-upstream-to="origin/$BRANCH" "$BRANCH" >/dev/null 2>&1 || true
fi

echo ""
echo "✅ Repositorio preparado."
echo "   modo     -> $MODE"
if [[ "$MODE" == "fork" ]]; then
  echo "   Origin (fork)       -> $(git remote get-url origin)"
  echo "   Upstream (official) -> $(git remote get-url upstream)"
else
  echo "   Origin (official)   -> $(git remote get-url origin)"
  echo "   Upstream            -> n/a"
fi
echo "   branch   -> $(git branch --show-current)"
echo "   config   -> $CONFIG_FILE"
echo ""
echo "Recarga direnv para exportar la configuración persistida:"
echo "   direnv reload"
echo ""
echo "Siguiente paso recomendado:"
echo "   mvn13 verify"
EOF
cat > "$BIN_DIR/idempiere-remotes" <<'EOF'
#!/bin/bash
set -euo pipefail

if [[ ! -d "$IDEMPIERE_REPOSITORY/.git" ]]; then
  echo "❌ No hay repositorio en $IDEMPIERE_REPOSITORY"
  exit 1
fi

ORIGIN="$(git -C "$IDEMPIERE_REPOSITORY" remote get-url origin 2>/dev/null || true)"
UPSTREAM="$(git -C "$IDEMPIERE_REPOSITORY" remote get-url upstream 2>/dev/null || true)"
print_remote() { printf '%-20s %s\n' "$1" "$2"; }
print_remote "Git mode" "${IDEMPIERE_GIT_MODE:-unconfigured}"
case "${IDEMPIERE_GIT_MODE:-unconfigured}" in
  fork)
    print_remote "Origin (fork)" "${ORIGIN:-faltante}"
    print_remote "Upstream (official)" "${UPSTREAM:-faltante}"
    ;;
  official)
    print_remote "Origin (official)" "${ORIGIN:-faltante}"
    print_remote "Upstream" "n/a"
    ;;
  *)
    print_remote "Origin" "${ORIGIN:-faltante}"
    print_remote "Upstream" "${UPSTREAM:-n/a}"
    exit 1
    ;;
esac
EOF

cat > "$BIN_DIR/idempiere-sync-upstream" <<'EOF'
#!/bin/bash
set -euo pipefail

if [[ ! -d "$IDEMPIERE_REPOSITORY/.git" ]]; then
  echo "❌ No hay repositorio en $IDEMPIERE_REPOSITORY"
  exit 1
fi

cd "$IDEMPIERE_REPOSITORY"
current="$(git branch --show-current)"
if [[ "$current" != "$IDEMPIERE_BRANCH_EXPECTED" ]]; then
  echo "❌ Estás en '$current'. Cambia primero a $IDEMPIERE_BRANCH_EXPECTED."
  exit 1
fi
if [[ -n "$(git status --porcelain)" ]]; then
  echo "❌ Hay cambios locales sin guardar. Haz commit o stash antes de sincronizar."
  exit 1
fi

MODE="${IDEMPIERE_GIT_MODE:-unconfigured}"
ORIGIN="$(git remote get-url origin 2>/dev/null || true)"
UPSTREAM="$(git remote get-url upstream 2>/dev/null || true)"
case "$MODE" in
  fork)
    [[ -n "${IDEMPIERE_ORIGIN_URL:-}" && "$ORIGIN" == "$IDEMPIERE_ORIGIN_URL" ]] || { echo "❌ Origin no coincide con el fork persistido."; exit 1; }
    [[ "$UPSTREAM" == "$IDEMPIERE_OFFICIAL_URL" ]] || { echo "❌ Upstream no coincide con el repositorio oficial."; exit 1; }
    echo "▶ Fetch upstream..."
    git fetch upstream "$IDEMPIERE_BRANCH_EXPECTED"
    echo "▶ Fast-forward desde upstream/$IDEMPIERE_BRANCH_EXPECTED..."
    git merge --ff-only "upstream/$IDEMPIERE_BRANCH_EXPECTED"
    echo "▶ Publicando la rama actualizada en tu fork..."
    git push origin "$IDEMPIERE_BRANCH_EXPECTED"
    echo "✅ Fork sincronizado con upstream/$IDEMPIERE_BRANCH_EXPECTED"
    ;;
  official)
    [[ "$ORIGIN" == "$IDEMPIERE_OFFICIAL_URL" ]] || { echo "❌ Origin no coincide con el repositorio oficial."; exit 1; }
    [[ -z "$UPSTREAM" ]] || { echo "❌ Upstream no debe existir en modo official."; exit 1; }
    echo "▶ Modo oficial: actualizando desde origin/$IDEMPIERE_BRANCH_EXPECTED..."
    git pull --ff-only origin "$IDEMPIERE_BRANCH_EXPECTED"
    echo "✅ Rama oficial sincronizada."
    ;;
  *)
    echo "❌ Modo Git no configurado o inválido: $MODE"
    exit 1
    ;;
esac
EOF
cat > "$BIN_DIR/idempiere-new-feature" <<'EOF'
#!/bin/bash
set -euo pipefail

name="${1:-}"
if [[ -z "$name" ]]; then
  echo "Uso: idempiere-new-feature <nombre-rama>"
  echo "Ejemplo: idempiere-new-feature fix-payment-validation"
  exit 1
fi
git check-ref-format --branch "$name" >/dev/null 2>&1 || { echo "❌ Nombre de rama no válido: $name"; exit 1; }

if [[ ! -d "$IDEMPIERE_REPOSITORY/.git" ]]; then
  echo "❌ No hay repositorio en $IDEMPIERE_REPOSITORY"
  exit 1
fi

cd "$IDEMPIERE_REPOSITORY"

if [[ -n "$(git status --porcelain)" ]]; then
  echo "❌ Hay cambios locales sin guardar."
  exit 1
fi

switch_base() {
  local remote="$1"
  if git show-ref --verify --quiet "refs/heads/$IDEMPIERE_BRANCH_EXPECTED"; then
    git switch "$IDEMPIERE_BRANCH_EXPECTED"
  else
    git switch -c "$IDEMPIERE_BRANCH_EXPECTED" --track "$remote/$IDEMPIERE_BRANCH_EXPECTED"
  fi
}

MODE="${IDEMPIERE_GIT_MODE:-unconfigured}"
ORIGIN="$(git remote get-url origin 2>/dev/null || true)"
UPSTREAM="$(git remote get-url upstream 2>/dev/null || true)"
case "$MODE" in
  fork)
    [[ -n "${IDEMPIERE_ORIGIN_URL:-}" && "$ORIGIN" == "$IDEMPIERE_ORIGIN_URL" ]] || { echo "❌ Origin no coincide con el fork persistido."; exit 1; }
    [[ "$UPSTREAM" == "$IDEMPIERE_OFFICIAL_URL" ]] || { echo "❌ Upstream no coincide con el repositorio oficial."; exit 1; }
    git fetch upstream "$IDEMPIERE_BRANCH_EXPECTED"
    switch_base upstream
    git merge --ff-only "upstream/$IDEMPIERE_BRANCH_EXPECTED"
    BASE_REF="upstream/$IDEMPIERE_BRANCH_EXPECTED"
    ;;
  official)
    [[ "$ORIGIN" == "$IDEMPIERE_OFFICIAL_URL" ]] || { echo "❌ Origin no coincide con el repositorio oficial."; exit 1; }
    [[ -z "$UPSTREAM" ]] || { echo "❌ Upstream no debe existir en modo official."; exit 1; }
    git fetch origin "$IDEMPIERE_BRANCH_EXPECTED"
    switch_base origin
    git merge --ff-only "origin/$IDEMPIERE_BRANCH_EXPECTED"
    BASE_REF="origin/$IDEMPIERE_BRANCH_EXPECTED"
    ;;
  *)
    echo "❌ Modo Git no configurado o inválido: $MODE"
    exit 1
    ;;
esac

git switch -c "$name"
echo "✅ Rama '$name' creada desde $BASE_REF"
EOF

cat > "$BIN_DIR/idempiere-doctor" <<'EOF'
#!/bin/bash
set -uo pipefail

section() { printf "\n%s\n%s\n" "$1" "$(printf '%*s' ${#1} '' | tr ' ' '-')"; }
ok()      { printf "✅ %s\n" "$1"; }
warn()    { printf "⚠️  %s\n" "$1"; }
fail()    { printf "❌ %s\n" "$1"; }
info()    { printf "ℹ️  %s\n" "$1"; }
value()   { printf "   • %-22s %s\n" "$1" "$2"; }

DOCTOR_FAILURES=0
DOCTOR_WARNS=0

note_ok()   { ok "$1"; }
note_warn() { warn "$1"; DOCTOR_WARNS=$((DOCTOR_WARNS+1)); }
note_fail() { fail "$1"; DOCTOR_FAILURES=$((DOCTOR_FAILURES+1)); }

get_java_major() {
  "$JAVA_HOME/bin/java" -version 2>&1 |
    awk -F '[".]' '/version/ { if ($2 == "1") print $3; else print $2; exit }'
}

xml_value() {
  local file="$1" tag="$2"
  awk -v open="<$tag>" -v close="</$tag>" '
    { start=index($0, open); if (start) { value=substr($0, start+length(open)); finish=index(value, close); if (finish) { print substr(value, 1, finish-1); exit } } }
  ' "$file"
}

section "Doctor de entorno iDempiere 13"
info "Revisa Java, Maven Wrapper, aislamiento local, Eclipse y configuración Git para contribuciones."

section "1) Entorno base"
value "Sistema" "$IDEMPIERE_OS"
[[ -d "$IDEM13_ROOT" ]] && note_ok "Raíz del entorno presente" || note_fail "No existe $IDEM13_ROOT"
[[ -x "$JAVA_HOME/bin/java" ]] && note_ok "JAVA_HOME válido" || note_fail "JAVA_HOME inválido: $JAVA_HOME"
[[ -f "$MAVEN_USER_SETTINGS" ]] && note_ok "settings.xml local presente" || note_fail "Falta $MAVEN_USER_SETTINGS"
[[ -d "$MVN_LOCAL_REPO" ]] && note_ok "Repositorio Maven aislado presente" || note_fail "Falta $MVN_LOCAL_REPO"
[[ -d "$ECLIPSE_WORKSPACE" ]] && note_ok "Workspace local presente" || note_fail "Falta $ECLIPSE_WORKSPACE"
[[ -d "$ECLIPSE_P2" ]] && note_ok ".p2 local presente" || note_fail "Falta $ECLIPSE_P2"
[[ -d "$BIN_DIR" ]] && note_ok "Wrappers locales presentes" || note_fail "Falta $BIN_DIR"
value "Eclipse exec" "$ECLIPSE_EXECUTABLE"
command -v git >/dev/null 2>&1 && note_ok "git disponible" || note_fail "git no disponible"
[[ -z "${IDEMPIERE_GIT_CONFIG_ERROR:-}" ]] \
  && note_ok "Configuración Git declarativa válida o pendiente" \
  || note_fail "Configuración Git inválida: $IDEMPIERE_GIT_CONFIG_ERROR"

section "2) Java"
JAVA_MAJOR="$(get_java_major 2>/dev/null || true)"
value "JAVA_HOME" "$JAVA_HOME"
value "Java major" "${JAVA_MAJOR:-desconocido}"
if [[ "$JAVA_MAJOR" == "17" ]]; then
  note_ok "Java 17 coincide con iDempiere release-13"
else
  note_fail "Se esperaba Java 17; se detectó ${JAVA_MAJOR:-desconocido}"
fi

section "3) Repo iDempiere"
if [[ -d "$IDEMPIERE_REPOSITORY/.git" ]]; then
  note_ok "Repositorio Git detectado"
  BRANCH="$(git -C "$IDEMPIERE_REPOSITORY" branch --show-current 2>/dev/null || true)"
  value "Branch actual" "${BRANCH:-desconocido}"
  value "Branch base" "$IDEMPIERE_BRANCH_EXPECTED"

  ORIGIN="$(git -C "$IDEMPIERE_REPOSITORY" remote get-url origin 2>/dev/null || true)"
  UPSTREAM="$(git -C "$IDEMPIERE_REPOSITORY" remote get-url upstream 2>/dev/null || true)"
  value "Modo Git" "${IDEMPIERE_GIT_MODE:-unconfigured}"
  value "Config Git" "$IDEMPIERE_GIT_CONFIG"

  if [[ "${IDEMPIERE_GIT_MODE:-unconfigured}" == "fork" ]]; then
    value "Origin (fork)" "${ORIGIN:-faltante}"
    value "Upstream (official)" "${UPSTREAM:-faltante}"
    [[ -n "${IDEMPIERE_ORIGIN_URL:-}" && "$ORIGIN" == "$IDEMPIERE_ORIGIN_URL" ]] \
      && note_ok "origin coincide con el fork persistido" \
      || note_warn "origin no coincide con IDEMPIERE_ORIGIN_URL"
    [[ "$UPSTREAM" == "$IDEMPIERE_OFFICIAL_URL" ]] \
      && note_ok "upstream apunta al repositorio oficial" \
      || note_warn "upstream no apunta al repositorio oficial"
  elif [[ "${IDEMPIERE_GIT_MODE:-unconfigured}" == "official" ]]; then
    value "Origin (official)" "${ORIGIN:-faltante}"
    value "Upstream" "${UPSTREAM:-n/a}"
    [[ "$ORIGIN" == "$IDEMPIERE_OFFICIAL_URL" ]] \
      && note_ok "origin apunta al repositorio oficial" \
      || note_warn "origin no apunta al repositorio oficial"
    [[ -z "$UPSTREAM" ]] \
      && note_ok "upstream no está configurado en modo official" \
      || note_warn "upstream no debe existir en modo official"
  else
    value "Origin" "${ORIGIN:-faltante}"
    value "Upstream" "${UPSTREAM:-n/a}"
    note_warn "Modo Git no configurado todavía"
  fi
else
  note_warn "Aún no se ha clonado el repositorio"
  info "Ejecuta: idempiere-clone"
fi

section "4) Maven Wrapper"
if [[ -x "$IDEMPIERE_REPOSITORY/mvnw" ]]; then
  note_ok "mvnw presente y ejecutable"

  WRAPPER_PROPS="$IDEMPIERE_REPOSITORY/.mvn/wrapper/maven-wrapper.properties"
  if [[ -f "$WRAPPER_PROPS" ]]; then
    DIST_URL="$(grep '^distributionUrl=' "$WRAPPER_PROPS" | cut -d= -f2- || true)"
    value "distributionUrl" "$DIST_URL"
    case "$DIST_URL" in
      *apache-maven-3.9.10-*) note_ok "Wrapper configurado con Maven 3.9.10" ;;
      *) note_warn "La versión Maven del wrapper cambió respecto a la release-13 revisada" ;;
    esac
  else
    note_warn "No encuentro maven-wrapper.properties"
  fi
else
  note_warn "mvnw no está disponible; probablemente falta clonar el repo"
fi

section "5) Metadatos de release-13"
PARENT_POM="$IDEMPIERE_REPOSITORY/org.idempiere.parent/pom.xml"
if [[ -f "$PARENT_POM" ]]; then
  REVISION="$(xml_value "$PARENT_POM" "revision" 2>/dev/null || true)"
  JDK_VERSION="$(xml_value "$PARENT_POM" "jdk.version" 2>/dev/null || true)"
  TYCHO_VERSION="$(xml_value "$PARENT_POM" "tycho.version" 2>/dev/null || true)"

  value "revision" "${REVISION:-desconocida}"
  value "jdk.version" "${JDK_VERSION:-desconocida}"
  value "tycho.version" "${TYCHO_VERSION:-desconocida}"

  [[ "$JDK_VERSION" == "17" ]] && note_ok "POM declara JDK 17" || note_warn "El POM ya no declara JDK 17"
  [[ "$REVISION" == 13.* ]] && note_ok "POM corresponde a la línea 13" || note_warn "La revisión no parece 13.x"
else
  note_warn "No encuentro org.idempiere.parent/pom.xml"
fi

section "6) Eclipse"
if [[ -x "$ECLIPSE_EXECUTABLE" ]]; then
  note_ok "Eclipse local instalado"
else
  note_warn "No encuentro Eclipse en $ECLIPSE_EXECUTABLE"
  info "La guía recomienda Eclipse IDE for Enterprise Java and Web Developers."
fi

section "7) SSH a GitHub"
if [[ "${IDEMPIERE_ORIGIN_URL:-}" == git@github.com:* || "${IDEMPIERE_ORIGIN_URL:-}" == ssh://git@github.com/* ]]; then
  if ! command -v ssh >/dev/null 2>&1; then
    note_fail "El origin usa SSH, pero ssh no está disponible"
  else
  SSH_OUT="$(ssh -o BatchMode=yes -o ConnectTimeout=5 -T git@github.com 2>&1 || true)"
    if echo "$SSH_OUT" | grep -qi "successfully authenticated"; then
      note_ok "Autenticación SSH con GitHub funcional"
    else
      note_warn "No pude confirmar autenticación SSH con GitHub"
    fi
  fi
else
  info "No se requiere comprobar SSH para la URL origin configurada."
fi

section "8) Lectura rápida"
if (( DOCTOR_FAILURES == 0 && DOCTOR_WARNS == 0 )); then
  ok "Todo se ve consistente para desarrollar y contribuir en iDempiere 13."
elif (( DOCTOR_FAILURES == 0 )); then
  warn "Entorno usable, con algunos puntos a revisar."
else
  fail "Hay problemas que conviene corregir antes de compilar."
fi

value "Fallos" "$DOCTOR_FAILURES"
value "Avisos" "$DOCTOR_WARNS"

section "9) Comandos útiles"
info "idempiere-clone                    -> pregunta oficial/fork y persiste la configuración"
info "mvn13 verify                      -> build oficial usando ./mvnw y Maven aislado"
info "mvn13 validate                    -> materialización rápida para Eclipse"
info "idempiere-sync-upstream           -> sincroniza release-13 desde upstream y publica en tu fork"
info "idempiere-new-feature <rama>      -> crea una rama nueva desde upstream/release-13"
info "idempiere-remotes                 -> muestra origin/upstream"
info "eclipse-start                     -> abre Eclipse con Java 17, workspace y .p2 aislados"

(( DOCTOR_FAILURES == 0 )) || exit 1
EOF

chmod +x \
  "$BIN_DIR/mvn13" \
  "$BIN_DIR/eclipse-start" \
  "$BIN_DIR/eclipse-choose" \
  "$BIN_DIR/idempiere-root" \
  "$BIN_DIR/idempiere-clone" \
  "$BIN_DIR/idempiere-remotes" \
  "$BIN_DIR/idempiere-sync-upstream" \
  "$BIN_DIR/idempiere-new-feature" \
  "$BIN_DIR/idempiere-doctor"

# --- PATH ---
PATH_add "$(dirname "$ECLIPSE_EXECUTABLE")"
PATH_add "$JAVA_HOME/bin"
PATH_add "$BIN_DIR"

# ==============================================================
# Validaciones de arranque
# ==============================================================
_warns=()

[[ -x "$ECLIPSE_EXECUTABLE" ]] || _warns+=("Eclipse no encontrado en $ECLIPSE_EXECUTABLE")
command -v git >/dev/null 2>&1 || _warns+=("git no está en PATH")
if [[ "${IDEMPIERE_ORIGIN_URL:-}" == git@github.com:* || "${IDEMPIERE_ORIGIN_URL:-}" == ssh://git@github.com/* ]]; then
  command -v ssh >/dev/null 2>&1 || _warns+=("origin usa SSH, pero ssh no está en PATH")
fi
[[ -z "${IDEMPIERE_GIT_CONFIG_ERROR:-}" ]] || _warns+=("Configuración Git inválida: $IDEMPIERE_GIT_CONFIG_ERROR")

if [[ -d "$IDEMPIERE_REPOSITORY/.git" && ! -x "$IDEMPIERE_REPOSITORY/mvnw" ]]; then
  _warns+=("El repo existe pero no se encontró mvnw ejecutable")
fi

# ==============================================================
# Panel visual
# ==============================================================
if [[ -t 1 && -n "${TERM:-}" ]] && command -v tput >/dev/null 2>&1 && tput colors >/dev/null 2>&1; then
  _bold=$(tput bold); _dim=$(tput dim); _reset=$(tput sgr0)
  _c1=$(tput setaf 6); _c2=$(tput setaf 2); _c3=$(tput setaf 5)
  _c4=$(tput setaf 4); _cY=$(tput setaf 3); _cR=$(tput setaf 1)
else
  _bold=''; _dim=''; _reset=''
  _c1=''; _c2=''; _c3=''; _c4=''; _cY=''; _cR=''
fi

_print_kv () { printf "  ${_bold}%-17s${_reset} %s\n" "$1" "$2"; }

if [[ -d "$IDEMPIERE_REPOSITORY/.git" ]]; then
  _repo_status="${_c2}OK${_reset}"
  _current_branch="$(git -C "$IDEMPIERE_REPOSITORY" branch --show-current 2>/dev/null || true)"
else
  _repo_status="${_cY}pendiente de clonar${_reset}"
  _current_branch="-"
fi

if [[ -x "$ECLIPSE_EXECUTABLE" ]]; then
  _eclipse_status="${_c2}OK${_reset}"
else
  _eclipse_status="${_cR}faltante${_reset}"
fi

if [[ -x "$IDEMPIERE_REPOSITORY/mvnw" ]]; then
  _maven_status="${_c2}mvnw OK${_reset}"
else
  _maven_status="${_cY}mvnw pendiente${_reset}"
fi

if command -v git >/dev/null 2>&1; then
  _git_status="${_c2}OK${_reset}"
else
  _git_status="${_cR}faltante${_reset}"
fi

case "$IDEMPIERE_GIT_MODE" in
  fork)
    _origin_label="Origin (fork)"
    _origin_value="${IDEMPIERE_ORIGIN_URL:-no-configurado}"
    _upstream_label="Upstream (official)"
    _upstream_value="${IDEMPIERE_UPSTREAM_URL:-no-configurado}"
    ;;
  official)
    _origin_label="Origin (official)"
    _origin_value="${IDEMPIERE_ORIGIN_URL:-no-configurado}"
    _upstream_label="Upstream"
    _upstream_value="n/a"
    ;;
  *)
    _origin_label="Origin"
    _origin_value="no-configurado"
    _upstream_label="Upstream"
    _upstream_value="n/a"
    ;;
esac

hr_top="┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓"
hr_mid="┣━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┫"
hr_bot="┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛"

echo ""
echo "${_c1}${hr_top}${_reset}"
printf "┃ ${_bold}iDempiere 13 — Entorno aislado / contribución${_reset} %-18s ┃\n" ""
echo "${_c1}${hr_mid}${_reset}"
_print_kv "Sistema"         "${_c1}$IDEMPIERE_OS${_reset}"
_print_kv "JAVA_HOME"       "${_c2}$JAVA_HOME${_reset}"
_print_kv "Maven"           "$_maven_status"
_print_kv "Maven user home" "${_c3}$MAVEN_USER_HOME${_reset}"
_print_kv "Repo Maven"      "${_c3}$MVN_LOCAL_REPO${_reset}"
_print_kv "Eclipse"         "${_c4}$ECLIPSE_HOME${_reset}"
_print_kv "Eclipse exec"    "${_c4}$ECLIPSE_EXECUTABLE${_reset}"
_print_kv "Eclipse status"  "$_eclipse_status"
_print_kv "Workspace"       "${_c4}$ECLIPSE_WORKSPACE${_reset}"
_print_kv "Sources"         "${_cY}$SOURCES_DIR${_reset}"
_print_kv "IDEMPIERE_REPO"  "${_cY}$IDEMPIERE_REPOSITORY${_reset}"
_print_kv "Repo estado"     "$_repo_status"
_print_kv "Git status"      "$_git_status"
_print_kv "Branch esperado" "${_cY}$IDEMPIERE_BRANCH_EXPECTED${_reset}"
_print_kv "Branch actual"   "${_cY}${_current_branch}${_reset}"
_print_kv "Git mode"        "${_cY}$IDEMPIERE_GIT_MODE${_reset}"
_print_kv "Git config"      "${_cY}$IDEMPIERE_GIT_CONFIG${_reset}"
_print_kv "$_origin_label"  "${_cY}${_origin_value}${_reset}"
_print_kv "$_upstream_label" "${_cY}${_upstream_value}${_reset}"
_print_kv "Eclipse p2"      "${_c4}$ECLIPSE_P2${_reset}"
echo "${_c1}${hr_bot}${_reset}"
echo "💡 ${_dim}Comandos:${_reset} ${_bold}idempiere-clone${_reset} | ${_bold}mvn13${_reset} | ${_bold}idempiere-doctor${_reset} | ${_bold}idempiere-sync-upstream${_reset} | ${_bold}idempiere-new-feature${_reset} | ${_bold}eclipse-start${_reset}"

if [[ ${#_warns[@]} -gt 0 ]]; then
  echo ""
  echo "${_cY}${_bold}Avisos:${_reset}"
  for w in "${_warns[@]}"; do
    printf "  ${_cY}- %s${_reset}\n" "$w"
  done
fi

echo ""
