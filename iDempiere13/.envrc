cat > "$IDEMPIERE_MAN_ROOT/en/man1/idempiere-remotes.1" <<'EOF'
.TH IDEMPIERE-REMOTES 1 "2026-10-06" "iDempiere 13" "Local commands"
.SH NAME
idempiere-remotes
.SH SYNOPSIS
idempiere-remotes
.SH DESCRIPTION
Displays Git remotes and their URLs without changing the repository.
.SH EXAMPLE
idempiere-remotes
.SH HELP
idempiere-remotes help | idempiere-remotes --help | idempiere-remotes -h
.br
idempiere-help idempiere-remotes
EOF
cat > "$IDEMPIERE_MAN_ROOT/en/man1/idempiere-git-check.1" <<'EOF'
.TH IDEMPIERE-GIT-CHECK 1 "2026-10-06" "iDempiere 13" "Local commands"
.SH NAME
idempiere-git-check
.SH SYNOPSIS
idempiere-git-check
.SH DESCRIPTION
Checks origin and upstream against the saved Git mode. Returns an error if they disagree.
.SH EXAMPLE
idempiere-git-check
.SH HELP
idempiere-git-check help | idempiere-git-check --help | idempiere-git-check -h
.br
idempiere-help idempiere-git-check
EOF
cat > "$IDEMPIERE_MAN_ROOT/en/man1/idempiere-sync-upstream.1" <<'EOF'
.TH IDEMPIERE-SYNC-UPSTREAM 1 "2026-10-06" "iDempiere 13" "Local commands"
.SH NAME
idempiere-sync-upstream
.SH SYNOPSIS
idempiere-sync-upstream
.SH DESCRIPTION
Updates local release-13 by fast-forward from upstream (fork) or origin (official). Requires release-13 and a clean tree. Uses the network; does not publish changes.
.SH EXAMPLE
idempiere-sync-upstream
.SH HELP
idempiere-sync-upstream help | idempiere-sync-upstream --help | idempiere-sync-upstream -h
.br
idempiere-help idempiere-sync-upstream
EOF
cat > "$IDEMPIERE_MAN_ROOT/en/man1/idempiere-new-feature.1" <<'EOF'
.TH IDEMPIERE-NEW-FEATURE 1 "2026-10-06" "iDempiere 13" "Local commands"
.SH NAME
idempiere-new-feature
.SH SYNOPSIS
idempiere-new-feature <branch>
.SH DESCRIPTION
Updates release-13 and creates a branch from the official remote reference. Requires a clean tree. Uses the network. Use one branch per ticket for core contributions.
.SH EXAMPLE
idempiere-new-feature IDEMPIERE-1234-fix-payment
.SH HELP
idempiere-new-feature help | idempiere-new-feature --help | idempiere-new-feature -h
.br
idempiere-help idempiere-new-feature
EOF
cat > "$IDEMPIERE_MAN_ROOT/en/man1/idempiere-doctor.1" <<'EOF'
.TH IDEMPIERE-DOCTOR 1 "2026-10-06" "iDempiere 13" "Local commands"
.SH NAME
idempiere-doctor
.SH SYNOPSIS
idempiere-doctor [--network]
.SH DESCRIPTION
Diagnoses Java, Maven, Eclipse and Git without changing them. --network also checks GitHub SSH. Returns an error for blocking failures; warnings do not cause an error.
.SH EXAMPLE
idempiere-doctor --network
.SH HELP
idempiere-doctor help | idempiere-doctor --help | idempiere-doctor -h
.br
idempiere-help idempiere-doctor
EOF
cat > "$IDEMPIERE_MAN_ROOT/en/man1/idempiere-help.1" <<'EOF'
.TH IDEMPIERE-HELP 1 "2026-10-06" "iDempiere 13" "Local commands"
.SH NAME
idempiere-help
.SH SYNOPSIS
idempiere-help [command]
.SH DESCRIPTION
Lists custom commands or displays help for one. Each command also accepts help, --help or -h, and man <command>.
.SH EXAMPLE
idempiere-help mvn13
.SH HELP
idempiere-help help | idempiere-help --help | idempiere-help -h
.br
idempiere-help idempiere-help
EOF
# A trailing colon preserves the system manual search path.
# Keep reloads idempotent without discarding an existing MANPATH.
if [[ -n "${IDEMPIERE_MAN_SELECTED:-}" ]]; then
  MANPATH="${MANPATH#"$IDEMPIERE_MAN_SELECTED:"}"
fi
export IDEMPIERE_MAN_SELECTED="$IDEMPIERE_MAN_ROOT/$(_idem_language)"
export MANPATH="$IDEMPIERE_MAN_SELECTED:${MANPATH:-}"

# mvn13: usa SIEMPRE el Maven Wrapper que viene con release-13.
cat > "$BIN_DIR/mvn13" <<'EOF'
#!/bin/bash
set -euo pipefail
source "${BIN_DIR:?}/idempiere-common.sh"
case "${1:-}" in
  help|--help|-h) _idem_help "mvn13"; exit 0 ;;
  --man) exec man "mvn13" ;;
esac

if [[ ! -x "$IDEMPIERE_REPOSITORY/mvnw" ]]; then
  echo "$(_idem_text "❌ No existe $IDEMPIERE_REPOSITORY/mvnw" "❌ Not found: $IDEMPIERE_REPOSITORY/mvnw")"
  echo "$(_idem_text "   Primero ejecuta: idempiere-clone" "   First run: idempiere-clone")"
  exit 1
fi

cd "$IDEMPIERE_REPOSITORY"

exec env \
  JAVA_HOME="$JAVA_HOME" \
  MAVEN_USER_HOME="$MAVEN_USER_HOME" \
  JAVA_TOOL_OPTIONS="-Djava.awt.headless=true ${JAVA_TOOL_OPTIONS:-}" \
  ./mvnw \
  -s "$MAVEN_USER_SETTINGS" \
  -Dmaven.repo.local="$MVN_LOCAL_REPO" \
  "$@"
EOF

cat > "$BIN_DIR/eclipse-start" <<'EOF'
#!/bin/bash
set -euo pipefail
source "${BIN_DIR:?}/idempiere-common.sh"
case "${1:-}" in
  help|--help|-h) _idem_help "eclipse-start"; exit 0 ;;
  --man) exec man "eclipse-start" ;;
esac

if [[ ! -x "$ECLIPSE_EXECUTABLE" ]]; then
