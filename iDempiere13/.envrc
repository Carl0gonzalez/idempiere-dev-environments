cat > "$BIN_DIR/idempiere-root" <<'EOF'
#!/bin/bash
set -euo pipefail
source "${BIN_DIR:?}/idempiere-common.sh"
case "${1:-}" in
  help|--help|-h) _idem_help "idempiere-root"; exit 0 ;;
  --man) exec man "idempiere-root" ;;
esac

if [[ ! -d "$IDEMPIERE_REPOSITORY" ]]; then
  echo "$(_idem_text "❌ No existe $IDEMPIERE_REPOSITORY" "❌ Not found: $IDEMPIERE_REPOSITORY")"
  exit 1
fi

cd "$IDEMPIERE_REPOSITORY"
exec "${SHELL:-/bin/bash}"
EOF

cat > "$BIN_DIR/idempiere-clone" <<'EOF'
#!/bin/bash
set -euo pipefail
source "${BIN_DIR:?}/idempiere-common.sh"
case "${1:-}" in
  help|--help|-h) _idem_help "idempiere-clone"; exit 0 ;;
  --man) exec man "idempiere-clone" ;;
esac

CONFIG_FILE="${IDEMPIERE_GIT_CONFIG:?}"
OFFICIAL_URL="${IDEMPIERE_OFFICIAL_URL:?}"
BRANCH="${IDEMPIERE_BRANCH_EXPECTED:?}"

save_config() {
  local mode="$1" origin="$2" upstream="$3"
  local tmp=""
  tmp="$(mktemp "${CONFIG_FILE}.tmp.XXXXXX")"
  chmod 600 "$tmp"
  {
    printf '%s\n' '# Generado por idempiere-clone. Puede editarse manualmente.'
    printf 'IDEMPIERE_GIT_MODE=%s\n' "$mode"
    printf 'IDEMPIERE_ORIGIN_URL=%s\n' "$origin"
    printf 'IDEMPIERE_UPSTREAM_URL=%s\n' "$upstream"
  } > "$tmp"
  mv "$tmp" "$CONFIG_FILE"
}

if [[ -e "$IDEMPIERE_REPOSITORY/.git" ]]; then
  echo "$(_idem_text "✅ Repo ya presente en $IDEMPIERE_REPOSITORY" "✅ Repository already exists at $IDEMPIERE_REPOSITORY")"
  echo "   origin   -> $(git -C "$IDEMPIERE_REPOSITORY" remote get-url origin 2>/dev/null || _idem_text "faltante" "missing")"
  echo "   upstream -> $(git -C "$IDEMPIERE_REPOSITORY" remote get-url upstream 2>/dev/null || _idem_text "no-configurado" "not configured")"
  "$BIN_DIR/idempiere-git-check"
  exit 0
fi

if [[ -e "$IDEMPIERE_REPOSITORY" ]] && [[ -n "$(ls -A "$IDEMPIERE_REPOSITORY" 2>/dev/null || true)" ]]; then
  echo "$(_idem_text "❌ $IDEMPIERE_REPOSITORY existe y no está vacío." "❌ $IDEMPIERE_REPOSITORY exists and is not empty.")"
  echo "$(_idem_text "   No se clonará encima para evitar pérdida de datos." "   Cloning into it is refused to protect existing data.")"
  exit 1
fi

command -v git >/dev/null 2>&1 || { echo "$(_idem_text "❌ git no está disponible en PATH" "❌ git is not available in PATH")"; exit 1; }
mkdir -p "$SOURCES_DIR"

echo ""
echo "$(_idem_text "¿Qué repositorio quieres usar para este entorno?" "Which repository do you want to use for this environment?")"
echo "$(_idem_text "  1) Repositorio oficial de iDempiere" "  1) Official iDempiere repository")"
echo "     $OFFICIAL_URL"
echo "$(_idem_text "  2) Mi fork (recomendado si vas a contribuir mediante Pull Requests)" "  2) My fork (recommended for Pull Request contributions)")"
echo ""
read -r -p "$(_idem_text "Selecciona [1/2]: " "Choose [1/2]: ")" choice

case "$choice" in
  1|official|oficial)
    MODE="official"
    ORIGIN_URL="$OFFICIAL_URL"
    UPSTREAM_URL=""
    ;;
  2|fork)
    MODE="fork"
    echo ""
    read -r -p "$(_idem_text "URL Git de tu fork (SSH o HTTPS): " "Git URL of your fork (SSH or HTTPS): ")" ORIGIN_URL
    if [[ ! "$ORIGIN_URL" =~ ^(https://|ssh://|git@)[a-zA-Z0-9_./:@+-]+$ || "$ORIGIN_URL" == "$OFFICIAL_URL" ]]; then
      echo "$(_idem_text "❌ Debes indicar la URL de tu fork." "❌ Provide a valid URL for your own fork.")"
      exit 1
    fi
    UPSTREAM_URL="$OFFICIAL_URL"
    ;;
  *)
    echo "$(_idem_text "❌ Opción no válida." "❌ Invalid choice.")"
    exit 1
    ;;
esac

echo ""
echo "$(_idem_text "▶ Clonando $ORIGIN_URL ($BRANCH)..." "▶ Cloning $ORIGIN_URL ($BRANCH)...")"
git clone --origin origin --branch "$BRANCH" "$ORIGIN_URL" "$IDEMPIERE_REPOSITORY"
cd "$IDEMPIERE_REPOSITORY"

if [[ "$MODE" == "fork" ]]; then
  echo "$(_idem_text "▶ Configurando upstream oficial..." "▶ Configuring official upstream...")"
  git remote add upstream "$UPSTREAM_URL"
  git fetch upstream "$BRANCH"
  git branch --set-upstream-to="origin/$BRANCH" "$BRANCH" >/dev/null 2>&1 || true
else
  git branch --set-upstream-to="origin/$BRANCH" "$BRANCH" >/dev/null 2>&1 || true
fi

save_config "$MODE" "$ORIGIN_URL" "$UPSTREAM_URL"

echo ""
echo "$(_idem_text "✅ Repositorio preparado." "✅ Repository ready.")"
echo "$(_idem_text "   modo     -> $MODE" "   mode     -> $MODE")"
echo "   origin   -> $(git remote get-url origin)"
if [[ "$MODE" == "fork" ]]; then
  echo "   upstream -> $(git remote get-url upstream)"
fi
echo "   branch   -> $(git branch --show-current)"
echo "   config   -> $CONFIG_FILE"
echo ""
echo "$(_idem_text "Recarga direnv para exportar la configuración persistida:" "Reload direnv to export the saved configuration:")"
echo "   direnv reload"
echo ""
echo "$(_idem_text "Siguiente paso recomendado:" "Recommended next step:")"
echo "   mvn13 verify"
EOF
cat > "$BIN_DIR/idempiere-remotes" <<'EOF'
#!/bin/bash
set -euo pipefail
source "${BIN_DIR:?}/idempiere-common.sh"
case "${1:-}" in
  help|--help|-h) _idem_help "idempiere-remotes"; exit 0 ;;
  --man) exec man "idempiere-remotes" ;;
esac

if [[ ! -d "$IDEMPIERE_REPOSITORY/.git" ]]; then
  echo "$(_idem_text "❌ No hay repositorio en $IDEMPIERE_REPOSITORY" "❌ No repository at $IDEMPIERE_REPOSITORY")"
  exit 1
fi

git -C "$IDEMPIERE_REPOSITORY" remote -v
EOF

cat > "$BIN_DIR/idempiere-git-check" <<'EOF'
#!/bin/bash
set -euo pipefail
source "${BIN_DIR:?}/idempiere-common.sh"
case "${1:-}" in
  help|--help|-h) _idem_help "idempiere-git-check"; exit 0 ;;
  --man) exec man "idempiere-git-check" ;;
esac
repo="${IDEMPIERE_REPOSITORY:?}"
[[ -e "$repo/.git" ]] || { echo "$(_idem_text "Falta el clon" "Checkout missing")"; exit 1; }
git -C "$repo" rev-parse --git-dir >/dev/null
origin="$(git -C "$repo" remote get-url origin)"
case "${IDEMPIERE_GIT_MODE:-unconfigured}" in
  official) [[ "$origin" == "$IDEMPIERE_OFFICIAL_URL" && -z "$(git -C "$repo" remote get-url upstream 2>/dev/null || true)" ]] ;;
  fork) [[ -n "$IDEMPIERE_ORIGIN_URL" && "$origin" == "$IDEMPIERE_ORIGIN_URL" && "$origin" != "$IDEMPIERE_OFFICIAL_URL" ]] &&
        [[ "$(git -C "$repo" remote get-url upstream)" == "$IDEMPIERE_OFFICIAL_URL" ]] ;;
  *) echo "$(_idem_text "Ejecuta idempiere-clone y configura el modo Git." "Run idempiere-clone and configure Git mode.")"; exit 1 ;;
esac || { echo "$(_idem_text "Los remotos no coinciden con la configuración Git." "Remotes do not match the Git configuration.")"; exit 1; }
EOF

cat > "$BIN_DIR/idempiere-sync-upstream" <<'EOF'
#!/bin/bash
set -euo pipefail
source "${BIN_DIR:?}/idempiere-common.sh"
case "${1:-}" in
  help|--help|-h) _idem_help "idempiere-sync-upstream"; exit 0 ;;
  --man) exec man "idempiere-sync-upstream" ;;
esac

if [[ ! -d "$IDEMPIERE_REPOSITORY/.git" ]]; then
  echo "$(_idem_text "❌ No hay repositorio en $IDEMPIERE_REPOSITORY" "❌ No repository at $IDEMPIERE_REPOSITORY")"
  exit 1
fi

"$BIN_DIR/idempiere-git-check"
cd "$IDEMPIERE_REPOSITORY"
current="$(git branch --show-current)"
if [[ "$current" != "$IDEMPIERE_BRANCH_EXPECTED" ]]; then
  echo "$(_idem_text "❌ Estás en '$current'. Cambia primero a $IDEMPIERE_BRANCH_EXPECTED." "❌ You are on '$current'. Switch to $IDEMPIERE_BRANCH_EXPECTED first.")"
  exit 1
fi
if [[ -n "$(git status --porcelain)" ]]; then
  echo "$(_idem_text "❌ Hay cambios locales sin guardar. Haz commit o stash antes de sincronizar." "❌ There are local changes. Commit or stash before syncing.")"
  exit 1
fi

MODE="${IDEMPIERE_GIT_MODE:-unconfigured}"
if [[ "$MODE" == "fork" ]] && git remote get-url upstream >/dev/null 2>&1; then
  echo "▶ Fetch upstream..."
  git fetch upstream
  echo "$(_idem_text "▶ Fast-forward desde upstream/$IDEMPIERE_BRANCH_EXPECTED..." "▶ Fast-forward from upstream/$IDEMPIERE_BRANCH_EXPECTED...")"
  git merge --ff-only "upstream/$IDEMPIERE_BRANCH_EXPECTED"
  echo "$(_idem_text "▶ Rama actualizada localmente." "▶ Local branch updated.")"
  echo "$(_idem_text "Para publicar la sincronización: git push origin $IDEMPIERE_BRANCH_EXPECTED" "To publish the sync: git push origin $IDEMPIERE_BRANCH_EXPECTED")"
  echo "$(_idem_text "✅ Fork sincronizado con upstream/$IDEMPIERE_BRANCH_EXPECTED" "✅ Local fork checkout synced with upstream/$IDEMPIERE_BRANCH_EXPECTED")"
else
  echo "$(_idem_text "▶ Modo oficial: actualizando desde origin/$IDEMPIERE_BRANCH_EXPECTED..." "▶ Official mode: updating from origin/$IDEMPIERE_BRANCH_EXPECTED...")"
  git pull --ff-only origin "$IDEMPIERE_BRANCH_EXPECTED"
  echo "$(_idem_text "✅ Rama oficial sincronizada." "✅ Official branch synced.")"
fi
EOF
cat > "$BIN_DIR/idempiere-new-feature" <<'EOF'
#!/bin/bash
set -euo pipefail
source "${BIN_DIR:?}/idempiere-common.sh"
case "${1:-}" in
  help|--help|-h) _idem_help "idempiere-new-feature"; exit 0 ;;
  --man) exec man "idempiere-new-feature" ;;
esac

name="${1:-}"
git check-ref-format --branch "$name" >/dev/null || exit 1
if git -C "$IDEMPIERE_REPOSITORY" show-ref --verify --quiet "refs/heads/$name"; then
  echo "$(_idem_text "La rama ya existe: $name" "Branch already exists: $name")"; exit 1
fi
if [[ -z "$name" ]]; then
  echo "$(_idem_text "Uso: idempiere-new-feature <nombre-rama>" "Usage: idempiere-new-feature <branch-name>")"
  echo "$(_idem_text "Ejemplo: idempiere-new-feature fix-payment-validation" "Example: idempiere-new-feature fix-payment-validation")"
  exit 1
fi

if [[ ! -d "$IDEMPIERE_REPOSITORY/.git" ]]; then
  echo "$(_idem_text "❌ No hay repositorio en $IDEMPIERE_REPOSITORY" "❌ No repository at $IDEMPIERE_REPOSITORY")"
  exit 1
fi

"$BIN_DIR/idempiere-git-check"
cd "$IDEMPIERE_REPOSITORY"

if [[ -n "$(git status --porcelain)" ]]; then
  echo "$(_idem_text "❌ Hay cambios locales sin guardar." "❌ There are local changes.")"
  exit 1
fi

if [[ "${IDEMPIERE_GIT_MODE:-unconfigured}" == "fork" ]] && git remote get-url upstream >/dev/null 2>&1; then
  git fetch upstream
  git switch "$IDEMPIERE_BRANCH_EXPECTED"
  git merge --ff-only "upstream/$IDEMPIERE_BRANCH_EXPECTED"
  BASE_REF="upstream/$IDEMPIERE_BRANCH_EXPECTED"
else
  git fetch origin
  git switch "$IDEMPIERE_BRANCH_EXPECTED"
  git merge --ff-only "origin/$IDEMPIERE_BRANCH_EXPECTED"
  BASE_REF="origin/$IDEMPIERE_BRANCH_EXPECTED"
fi

git check-ref-format --branch "$name" >/dev/null
git switch -c "$name" "$BASE_REF"
echo "$(_idem_text "✅ Rama '$name' creada desde $BASE_REF" "✅ Branch '$name' created from $BASE_REF")"
EOF

cat > "$BIN_DIR/idempiere-doctor" <<'EOF'
#!/bin/bash
set -uo pipefail
source "${BIN_DIR:?}/idempiere-common.sh"
case "${1:-}" in
  help|--help|-h) _idem_help "idempiere-doctor"; exit 0 ;;
  --man) exec man "idempiere-doctor" ;;
esac

section() { printf "\n%s\n%s\n" "$1" "$(printf '%*s' ${#1} '' | tr ' ' '-')"; }
ok()      { printf "✅ %s\n" "$1"; }
warn()    { printf "⚠️  %s\n" "$1"; }
fail()    { printf "❌ %s\n" "$1"; }
info()    { printf "ℹ️  %s\n" "$1"; }
value()   { printf "   • %-22s %s\n" "$1" "$2"; }

DOCTOR_FAILURES=0
DOCTOR_WARNS=0

note_ok()   { ok "$1"; }
note_warn() { warn "$1"; DOCTOR_WARNS=$((DOCTOR_WARNS+1)); }
note_fail() { fail "$1"; DOCTOR_FAILURES=$((DOCTOR_FAILURES+1)); }

get_java_major() {
  "$JAVA_HOME/bin/java" -version 2>&1 |
    awk -F '[".]' '/version/ { if ($2 == "1") print $3; else print $2; exit }'
}

section "$(_idem_text "Doctor de entorno iDempiere 13" "iDempiere 13 environment doctor")"
info "$(_idem_text "Revisa Java, Maven Wrapper, aislamiento local, Eclipse y configuración Git para contribuciones." "Checks Java, Maven Wrapper, local isolation, Eclipse and contribution Git configuration.")"

section "$(_idem_text "1) Entorno base" "1) Base environment")"
[[ -d "$IDEM13_ROOT" ]] && note_ok "$(_idem_text "Raíz del entorno presente" "Environment root exists")" || note_fail "$(_idem_text "No existe $IDEM13_ROOT" "Not found: $IDEM13_ROOT")"
[[ -x "$JAVA_HOME/bin/java" ]] && note_ok "$(_idem_text "JAVA_HOME válido" "Valid JAVA_HOME")" || note_fail "$(_idem_text "JAVA_HOME inválido: $JAVA_HOME" "Invalid JAVA_HOME: $JAVA_HOME")"
[[ -f "$MAVEN_USER_SETTINGS" ]] && note_ok "$(_idem_text "settings.xml local presente" "Local settings.xml exists")" || note_fail "$(_idem_text "Falta $MAVEN_USER_SETTINGS" "Missing $MAVEN_USER_SETTINGS")"
[[ -d "$MVN_LOCAL_REPO" ]] && note_ok "$(_idem_text "Repositorio Maven aislado presente" "Isolated Maven repository exists")" || note_fail "$(_idem_text "Falta $MVN_LOCAL_REPO" "Missing $MVN_LOCAL_REPO")"
[[ -d "$ECLIPSE_WORKSPACE" ]] && note_ok "$(_idem_text "Workspace local presente" "Local workspace exists")" || note_fail "$(_idem_text "Falta $ECLIPSE_WORKSPACE" "Missing $ECLIPSE_WORKSPACE")"
[[ -d "$ECLIPSE_P2" ]] && note_ok "$(_idem_text ".p2 local presente" "Local .p2 exists")" || note_fail "$(_idem_text "Falta $ECLIPSE_P2" "Missing $ECLIPSE_P2")"
[[ -d "$BIN_DIR" ]] && note_ok "$(_idem_text "Wrappers locales presentes" "Local wrappers exist")" || note_fail "$(_idem_text "Falta $BIN_DIR" "Missing $BIN_DIR")"
command -v git >/dev/null 2>&1 && note_ok "$(_idem_text "git disponible" "git available")" || note_fail "$(_idem_text "git no disponible" "git unavailable")"
command -v ssh >/dev/null 2>&1 && note_ok "$(_idem_text "ssh disponible" "ssh available")" || note_fail "$(_idem_text "ssh no disponible" "ssh unavailable")"

section "2) Java"
JAVA_MAJOR="$(get_java_major 2>/dev/null || true)"
value "JAVA_HOME" "$JAVA_HOME"
value "$(_idem_text "Versión de Java" "Java major")" "$(_idem_text "${JAVA_MAJOR:-desconocido}" "${JAVA_MAJOR:-unknown}")"
if [[ "$JAVA_MAJOR" == "17" ]]; then
  note_ok "$(_idem_text "Java 17 coincide con iDempiere release-13" "Java 17 matches iDempiere release-13")"
else
  note_fail "$(_idem_text "Se esperaba Java 17; se detectó ${JAVA_MAJOR:-desconocido}" "Expected Java 17; detected ${JAVA_MAJOR:-unknown}")"
fi

section "$(_idem_text "3) Repo iDempiere" "3) iDempiere repository")"
if [[ -e "$IDEMPIERE_REPOSITORY/.git" ]]; then
  note_ok "$(_idem_text "Repositorio Git detectado" "Git repository detected")"
  BRANCH="$(git -C "$IDEMPIERE_REPOSITORY" branch --show-current 2>/dev/null || true)"
  value "$(_idem_text "Branch actual" "Current branch")" "$(_idem_text "${BRANCH:-desconocido}" "${BRANCH:-unknown}")"
  value "$(_idem_text "Branch base" "Base branch")" "$IDEMPIERE_BRANCH_EXPECTED"

  ORIGIN="$(git -C "$IDEMPIERE_REPOSITORY" remote get-url origin 2>/dev/null || true)"
  UPSTREAM="$(git -C "$IDEMPIERE_REPOSITORY" remote get-url upstream 2>/dev/null || true)"
  value "origin" "$(_idem_text "${ORIGIN:-faltante}" "${ORIGIN:-missing}")"
  value "upstream" "$(_idem_text "${UPSTREAM:-faltante}" "${UPSTREAM:-missing}")"

  value "$(_idem_text "Modo Git" "Git mode")" "${IDEMPIERE_GIT_MODE:-unconfigured}"
  value "$(_idem_text "Config Git" "Git configuration")" "$IDEMPIERE_GIT_CONFIG"

  if [[ "${IDEMPIERE_GIT_MODE:-unconfigured}" == "fork" ]]; then
    [[ -n "${IDEMPIERE_ORIGIN_URL:-}" && "$ORIGIN" == "$IDEMPIERE_ORIGIN_URL" ]] \
      && note_ok "$(_idem_text "origin coincide con el fork persistido" "origin matches the saved fork")" \
      || note_warn "$(_idem_text "origin no coincide con IDEMPIERE_ORIGIN_URL" "origin does not match IDEMPIERE_ORIGIN_URL")"
    [[ "$UPSTREAM" == "$IDEMPIERE_OFFICIAL_URL" ]] \
      && note_ok "$(_idem_text "upstream apunta al repositorio oficial" "upstream points to the official repository")" \
      || note_warn "$(_idem_text "upstream no apunta al repositorio oficial" "upstream does not point to the official repository")"
  elif [[ "${IDEMPIERE_GIT_MODE:-unconfigured}" == "official" ]]; then
    [[ "$ORIGIN" == "$IDEMPIERE_OFFICIAL_URL" ]] \
      && note_ok "$(_idem_text "origin apunta al repositorio oficial" "origin points to the official repository")" \
      || note_warn "$(_idem_text "origin no apunta al repositorio oficial" "origin does not point to the official repository")"
  else
    note_warn "$(_idem_text "Modo Git no configurado todavía" "Git mode not configured yet")"
  fi
else
  note_warn "$(_idem_text "Aún no se ha clonado el repositorio" "Repository has not been cloned yet")"
  info "$(_idem_text "Ejecuta: idempiere-clone" "Run: idempiere-clone")"
fi

if [[ -e "$IDEMPIERE_REPOSITORY/.git" ]]; then
  "$BIN_DIR/idempiere-git-check" >/dev/null 2>&1 || note_fail "$(_idem_text "Configuración o remotos Git incoherentes" "Invalid Git configuration or remotes")"
fi

section "4) Maven Wrapper"
if [[ -x "$IDEMPIERE_REPOSITORY/mvnw" ]]; then
  note_ok "$(_idem_text "mvnw presente y ejecutable" "mvnw exists and is executable")"

  WRAPPER_PROPS="$IDEMPIERE_REPOSITORY/.mvn/wrapper/maven-wrapper.properties"
  if [[ -f "$WRAPPER_PROPS" ]]; then
    DIST_URL="$(grep '^distributionUrl=' "$WRAPPER_PROPS" | cut -d= -f2- || true)"
    value "distributionUrl" "$DIST_URL"
    case "$DIST_URL" in
      *apache-maven-3.9.10-*) note_ok "$(_idem_text "Wrapper configurado con Maven 3.9.10" "Wrapper configured with Maven 3.9.10")" ;;
      *) note_warn "$(_idem_text "La versión Maven del wrapper cambió respecto a la release-13 revisada" "Wrapper Maven version differs from the reviewed release-13")" ;;
    esac
  else
    note_warn "$(_idem_text "No encuentro maven-wrapper.properties" "Cannot find maven-wrapper.properties")"
  fi
else
  note_warn "$(_idem_text "mvnw no está disponible; probablemente falta clonar el repo" "mvnw unavailable; the repository may need cloning")"
fi

section "$(_idem_text "5) Metadatos de release-13" "5) release-13 metadata")"
PARENT_POM="$IDEMPIERE_REPOSITORY/org.idempiere.parent/pom.xml"
if [[ -f "$PARENT_POM" ]]; then
  REVISION="$(sed -n 's:.*<revision>\([^<]*\)</revision>.*:\1:p' "$PARENT_POM" | head -n 1)"
  JDK_VERSION="$(sed -n 's:.*<jdk.version>\([^<]*\)</jdk.version>.*:\1:p' "$PARENT_POM" | head -n 1)"
  TYCHO_VERSION="$(sed -n 's:.*<tycho.version>\([^<]*\)</tycho.version>.*:\1:p' "$PARENT_POM" | head -n 1)"

  value "revision" "$(_idem_text "${REVISION:-desconocida}" "${REVISION:-unknown}")"
  value "jdk.version" "$(_idem_text "${JDK_VERSION:-desconocida}" "${JDK_VERSION:-unknown}")"
  value "tycho.version" "$(_idem_text "${TYCHO_VERSION:-desconocida}" "${TYCHO_VERSION:-unknown}")"

  [[ "$JDK_VERSION" == "17" ]] && note_ok "$(_idem_text "POM declara JDK 17" "POM declares JDK 17")" || note_warn "$(_idem_text "El POM ya no declara JDK 17" "POM no longer declares JDK 17")"
  [[ "$REVISION" == 13.* ]] && note_ok "$(_idem_text "POM corresponde a la línea 13" "POM belongs to version 13")" || note_warn "$(_idem_text "La revisión no parece 13.x" "Revision does not appear to be 13.x")"
else
  note_warn "$(_idem_text "No encuentro org.idempiere.parent/pom.xml" "Cannot find org.idempiere.parent/pom.xml")"
fi

section "6) Eclipse"
if [[ -x "$ECLIPSE_EXECUTABLE" ]]; then
  note_ok "$(_idem_text "Eclipse local instalado" "Local Eclipse installed")"
else
  note_warn "$(_idem_text "No encuentro Eclipse en $ECLIPSE_EXECUTABLE" "Cannot find Eclipse at $ECLIPSE_EXECUTABLE")"
  info "$(_idem_text "La guía recomienda Eclipse IDE for Enterprise Java and Web Developers." "The guide recommends Eclipse IDE for Enterprise Java and Web Developers.")"
fi

section "$(_idem_text "7) SSH a GitHub (opcional: --network)" "7) GitHub SSH (optional: --network)")"
if [[ "${1:-}" == "--network" ]] && command -v ssh >/dev/null 2>&1; then
  SSH_OUT="$(ssh -o BatchMode=yes -o ConnectTimeout=5 -T git@github.com 2>&1 || true)"
  if echo "$SSH_OUT" | grep -qi "successfully authenticated"; then
    note_ok "$(_idem_text "Autenticación SSH con GitHub funcional" "GitHub SSH authentication works")"
  else
    note_warn "$(_idem_text "No pude confirmar autenticación SSH con GitHub" "Could not confirm GitHub SSH authentication")"
  fi
fi

section "$(_idem_text "8) Lectura rápida" "8) Overview")"
if (( DOCTOR_FAILURES == 0 && DOCTOR_WARNS == 0 )); then
  ok "$(_idem_text "Todo se ve consistente para desarrollar y contribuir en iDempiere 13." "Environment is consistent for iDempiere 13 development and contributions.")"
elif (( DOCTOR_FAILURES == 0 )); then
  warn "$(_idem_text "Entorno usable, con algunos puntos a revisar." "Usable environment, with items to review.")"
else
  fail "$(_idem_text "Hay problemas que conviene corregir antes de compilar." "Resolve the reported problems before building.")"
fi

value "$(_idem_text "Fallos" "Failures")" "$DOCTOR_FAILURES"
value "$(_idem_text "Avisos" "Warnings")" "$DOCTOR_WARNS"

section "$(_idem_text "9) Comandos útiles" "9) Useful commands")"
info "$(_idem_text "idempiere-clone                    -> pregunta oficial/fork y persiste la configuración" "idempiere-clone                    -> asks official/fork and saves configuration")"
info "$(_idem_text "mvn13 verify                      -> build oficial usando ./mvnw y Maven aislado" "mvn13 verify                      -> official build using ./mvnw and isolated Maven")"
info "$(_idem_text "mvn13 validate                    -> materialización rápida para Eclipse" "mvn13 validate                    -> quick materialization for Eclipse")"
info "$(_idem_text "idempiere-sync-upstream           -> sincroniza release-13 localmente desde upstream" "idempiere-sync-upstream           -> syncs local release-13 from upstream")"
info "$(_idem_text "idempiere-new-feature <rama>      -> crea una rama nueva desde upstream/release-13" "idempiere-new-feature <branch>      -> creates a new branch from upstream/release-13")"
info "$(_idem_text "idempiere-remotes                 -> muestra origin/upstream" "idempiere-remotes                 -> shows origin/upstream")"
info "$(_idem_text "eclipse-start                     -> abre Eclipse con Java 17, workspace y .p2 aislados" "eclipse-start                     -> opens Eclipse with Java 17, isolated workspace and .p2")"
exit "$((DOCTOR_FAILURES > 0))"
EOF

chmod +x \
  "$BIN_DIR/idempiere-git-check" \
  "$BIN_DIR/mvn13" \
  "$BIN_DIR/eclipse-start" \
  "$BIN_DIR/eclipse-choose" \
  "$BIN_DIR/idempiere-root" \
  "$BIN_DIR/idempiere-clone" \
  "$BIN_DIR/idempiere-remotes" \
  "$BIN_DIR/idempiere-sync-upstream" \
  "$BIN_DIR/idempiere-new-feature" \
  "$BIN_DIR/idempiere-doctor"

# --- PATH ---
PATH_add "$BIN_DIR"
PATH_add "$JAVA_HOME/bin"
PATH_add "$ECLIPSE_HOME"

# ==============================================================
# Validaciones de arranque
# ==============================================================
_warns=()

[[ -x "$ECLIPSE_EXECUTABLE" ]] || _warns+=("$(_idem_text "Eclipse no encontrado en $ECLIPSE_EXECUTABLE" "Eclipse not found at $ECLIPSE_EXECUTABLE")")
command -v git >/dev/null 2>&1 || _warns+=("$(_idem_text "git no está en PATH" "git is not in PATH")")
command -v ssh >/dev/null 2>&1 || _warns+=("$(_idem_text "ssh no está en PATH" "ssh is not in PATH")")

if [[ -d "$IDEMPIERE_REPOSITORY/.git" && ! -x "$IDEMPIERE_REPOSITORY/mvnw" ]]; then
  _warns+=("$(_idem_text "El repo existe pero no se encontró mvnw ejecutable" "Repository exists but no executable mvnw was found")")
fi

# ==============================================================
# Panel visual
# ==============================================================
if [[ -n "${TERM:-}" && "${TERM:-}" != "dumb" ]] && command -v tput >/dev/null 2>&1; then
  _bold=$(tput bold); _dim=$(tput dim); _reset=$(tput sgr0)
  _c1=$(tput setaf 6); _c2=$(tput setaf 2); _c3=$(tput setaf 5)
  _c4=$(tput setaf 4); _cY=$(tput setaf 3); _cR=$(tput setaf 1)
else
  _bold=''; _dim=''; _reset=''
  _c1=''; _c2=''; _c3=''; _c4=''; _cY=''; _cR=''
fi

_print_kv () { printf "  ${_bold}%-17s${_reset} %s\n" "$1" "$2"; }

if [[ -e "$IDEMPIERE_REPOSITORY/.git" ]]; then
  _repo_status="${_c2}OK${_reset}"
  _current_branch="$(git -C "$IDEMPIERE_REPOSITORY" branch --show-current 2>/dev/null || true)"
else
  _repo_status="$(_idem_text "${_cY}pendiente de clonar${_reset}" "${_cY}not cloned yet${_reset}")"
  _current_branch="-"
fi

if [[ -x "$ECLIPSE_EXECUTABLE" ]]; then
  _eclipse_status="${_c2}OK${_reset}"
else
  _eclipse_status="$(_idem_text "${_cR}faltante${_reset}" "${_cR}missing${_reset}")"
fi

if [[ -x "$IDEMPIERE_REPOSITORY/mvnw" ]]; then
  _maven_status="${_c2}mvnw OK${_reset}"
else
  _maven_status="$(_idem_text "${_cY}mvnw pendiente${_reset}" "${_cY}mvnw pending${_reset}")"
fi

if command -v git >/dev/null 2>&1; then
  _git_status="${_c2}OK${_reset}"
else
  _git_status="$(_idem_text "${_cR}faltante${_reset}" "${_cR}missing${_reset}")"
fi

hr_top="┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓"
hr_mid="┣━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┫"
hr_bot="┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛"

echo ""
echo "${_c1}${hr_top}${_reset}"
printf "$(_idem_text "┃ ${_bold}iDempiere 13 — Entorno aislado / contribución${_reset} %-18s ┃\n" "┃ ${_bold}iDempiere 13 — Isolated environment / contributions${_reset} %-18s ┃\n")" ""
echo "${_c1}${hr_mid}${_reset}"
_print_kv "JAVA_HOME"       "${_c2}$JAVA_HOME${_reset}"
_print_kv "Maven"           "$_maven_status"
_print_kv "$(_idem_text "Directorio Maven" "Maven user home")" "${_c3}$MAVEN_USER_HOME${_reset}"
_print_kv "$(_idem_text "Repo Maven" "Maven repository")"      "${_c3}$MVN_LOCAL_REPO${_reset}"
_print_kv "Eclipse"         "${_c4}$ECLIPSE_HOME${_reset}"
_print_kv "$(_idem_text "Estado de Eclipse" "Eclipse status")"  "$_eclipse_status"
_print_kv "$(_idem_text "Workspace" "Workspace")"       "${_c4}$ECLIPSE_WORKSPACE${_reset}"
_print_kv "$(_idem_text "Fuentes" "Sources")"         "${_cY}$SOURCES_DIR${_reset}"
_print_kv "IDEMPIERE_REPO"  "${_cY}$IDEMPIERE_REPOSITORY${_reset}"
_print_kv "$(_idem_text "Repo estado" "Repository status")"     "$_repo_status"
_print_kv "$(_idem_text "Estado de Git" "Git status")"      "$_git_status"
_print_kv "$(_idem_text "Branch esperado" "Expected branch")" "${_cY}$IDEMPIERE_BRANCH_EXPECTED${_reset}"
_print_kv "$(_idem_text "Branch actual" "Current branch")"   "${_cY}${_current_branch}${_reset}"
_print_kv "$(_idem_text "Modo Git" "Git mode")"        "${_cY}$IDEMPIERE_GIT_MODE${_reset}"
_print_kv "$(_idem_text "Configuración Git" "Git config")"      "${_cY}$IDEMPIERE_GIT_CONFIG${_reset}"
_print_kv "Origin"          "$(_idem_text "${_cY}${IDEMPIERE_ORIGIN_URL:-no-configurado}${_reset}" "${_cY}${IDEMPIERE_ORIGIN_URL:-not configured}${_reset}")"
_print_kv "Upstream"        "$(_idem_text "${_cY}${IDEMPIERE_UPSTREAM_URL:-no-configurado}${_reset}" "${_cY}${IDEMPIERE_UPSTREAM_URL:-not configured}${_reset}")"
_print_kv "Eclipse p2"      "${_c4}$ECLIPSE_P2${_reset}"
echo "${_c1}${hr_bot}${_reset}"
echo "$(_idem_text "💡 ${_dim}Comandos:${_reset} ${_bold}idempiere-clone${_reset} | ${_bold}mvn13${_reset} | ${_bold}idempiere-doctor${_reset} | ${_bold}idempiere-sync-upstream${_reset} | ${_bold}idempiere-new-feature${_reset} | ${_bold}eclipse-start${_reset}" "💡 ${_dim}Commands:${_reset} ${_bold}idempiere-clone${_reset} | ${_bold}mvn13${_reset} | ${_bold}idempiere-doctor${_reset} | ${_bold}idempiere-sync-upstream${_reset} | ${_bold}idempiere-new-feature${_reset} | ${_bold}eclipse-start${_reset}")"

if [[ ${#_warns[@]} -gt 0 ]]; then
  echo ""
  echo "$(_idem_text "${_cY}${_bold}Avisos:${_reset}" "${_cY}${_bold}Warnings:${_reset}")"
  for w in "${_warns[@]}"; do
    printf "  ${_cY}- %s${_reset}\n" "$w"
  done
fi

echo ""
echo "$(_idem_text 'Ayuda: idempiere-help | <comando> help | man <comando>' 'Help: idempiere-help | <command> help | man <command>')"
