# ==============================================================
# iDempiere 13 — Entorno aislado de desarrollo/contribución
# direnv + zsh/bash | Java 17 | Maven Wrapper oficial
#
# Git:
#   modo official -> origin = repositorio oficial
#   modo fork     -> origin = fork personal; upstream = repositorio oficial
# ==============================================================

# LC_ALL takes precedence over LC_MESSAGES and LANG. Other languages use English.
_idem_language() {
  case "${LC_ALL:-${LC_MESSAGES:-${LANG:-C}}}" in
    es|es_*|es.*|es-*) printf '%s' es ;;
    *) printf '%s' en ;;
  esac
}
_idem_text() {
  if [[ "$(_idem_language)" == es ]]; then printf '%s' "$1"; else printf '%s' "$2"; fi
}

# --- Raíz del entorno ---
export BASE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
export IDEM13_ROOT="$BASE"
export IDEMPIERE_OS="$(uname -s)"
export IDEMPIERE_JAVA_MAJOR_EXPECTED="17"

case "$IDEMPIERE_OS" in
  Linux|Darwin) ;;
  *)
    echo "❌ Sistema no compatible: $IDEMPIERE_OS"
    return 1 2>/dev/null || exit 1
    ;;
esac



# --- Rutas principales ---
export SOURCES_DIR="$BASE/sources"
export IDEMPIERE_HOME="$SOURCES_DIR/idempiere"
export IDEMPIERE_REPOSITORY="$IDEMPIERE_HOME"
export ECLIPSE_HOME="$BASE/eclipse"
export ECLIPSE_WORKSPACE="$BASE/workspace-13"
if [[ "$IDEMPIERE_OS" == "Darwin" ]]; then
  export ECLIPSE_EXECUTABLE="$ECLIPSE_HOME/Eclipse.app/Contents/MacOS/eclipse"
else
  export ECLIPSE_EXECUTABLE="$ECLIPSE_HOME/eclipse"
fi

# --- Git / colaboración ---
export IDEMPIERE_BRANCH_EXPECTED="release-13"
export IDEMPIERE_OFFICIAL_URL="https://github.com/idempiere/idempiere.git"
export IDEMPIERE_GIT_CONFIG="$BASE/.idempiere-git.env"
if command -v watch_file >/dev/null 2>&1; then
  watch_file "$IDEMPIERE_GIT_CONFIG"
fi

# Configuración persistente declarativa. Se analiza sin ejecutar código shell.
_git_mode="unconfigured"
_git_origin=""
_git_upstream=""
_git_config_error=""

if [[ -f "$IDEMPIERE_GIT_CONFIG" ]]; then
  while IFS= read -r _git_line || [[ -n "$_git_line" ]]; do
    [[ -z "$_git_line" || "$_git_line" == \#* ]] && continue
    _git_line="${_git_line#export }"
    if [[ "$_git_line" != *=* ]]; then
      _git_config_error="línea sin formato clave=valor"
      break
    fi
    _git_key="${_git_line%%=*}"
    _git_value="${_git_line#*=}"
    if [[ "$_git_value" == \"*\" && "$_git_value" == *\" ]]; then
      _git_value="${_git_value:1:${#_git_value}-2}"
    elif [[ "$_git_value" == \'*\' && "$_git_value" == *\' ]]; then
      _git_value="${_git_value:1:${#_git_value}-2}"
    fi
    case "$_git_key" in
      IDEMPIERE_GIT_MODE) _git_mode="$_git_value" ;;
      IDEMPIERE_ORIGIN_URL) _git_origin="$_git_value" ;;
      IDEMPIERE_UPSTREAM_URL) _git_upstream="$_git_value" ;;
      *) _git_config_error="clave no permitida: $_git_key"; break ;;
    esac
  done < "$IDEMPIERE_GIT_CONFIG"

  if [[ -z "$_git_config_error" ]]; then
    case "$_git_mode" in
      official)
        [[ "$_git_origin" == "$IDEMPIERE_OFFICIAL_URL" ]] || _git_config_error="origin no es el repositorio oficial"
        [[ -z "$_git_upstream" ]] || _git_config_error="upstream debe estar vacío en modo official"
        ;;
      fork)
        [[ -n "$_git_origin" ]] || _git_config_error="falta la URL del fork"
        case "$_git_origin" in
          https://*|http://*|ssh://*|git@*:*) ;;
          *) _git_config_error="URL del fork no válida" ;;
        esac
        [[ "$_git_origin" != *[$'\r\n\t ']* ]] || _git_config_error="la URL del fork contiene espacios o controles"
        [[ "$_git_upstream" == "$IDEMPIERE_OFFICIAL_URL" ]] || _git_config_error="upstream no es el repositorio oficial"
        ;;
      *) _git_config_error="modo Git no válido: $_git_mode" ;;
    esac
  fi
fi

if [[ -n "$_git_config_error" ]]; then
  _git_mode="unconfigured"
  _git_origin=""
  _git_upstream=""
fi

export IDEMPIERE_GIT_MODE="$_git_mode"
export IDEMPIERE_ORIGIN_URL="$_git_origin"
export IDEMPIERE_UPSTREAM_URL="$_git_upstream"
export IDEMPIERE_GIT_CONFIG_ERROR="$_git_config_error"
unset _git_mode _git_origin _git_upstream _git_config_error _git_line _git_key _git_value

# --- Maven completamente aislado ---
# iDempiere 13 trae Maven Wrapper y release-13 fija Maven 3.9.10.
# MAVEN_USER_HOME mantiene también wrapper/dists dentro de este entorno.
export MAVEN_USER_HOME="$BASE/.m2"
export MVN_LOCAL_REPO="$MAVEN_USER_HOME/repository"
export MAVEN_USER_SETTINGS="$MAVEN_USER_HOME/settings.xml"

# Compatibilidad con herramientas/scripts que consulten M2_HOME/MAVEN_HOME.
# No se define MAVEN_HOME: para iDempiere 13 se usa ./mvnw.
unset MAVEN_HOME
unset M2_HOME

# --- P2/Eclipse local (evita ensuciar ~/.p2) ---
export ECLIPSE_P2="$BASE/.p2"

# --- Directorio para scripts auxiliares ---
export BIN_DIR="$BASE/.local-bin"

# --- Java 17 (Linux/macOS; requisito de release-13) ---
IDEMPIERE_JAVA_HOME_OVERRIDE="${IDEMPIERE_JAVA_HOME_OVERRIDE:-${IDEMPIERE_JAVA_HOME:-}}"
JAVA_CANDIDATES=()
[[ -n "${IDEMPIERE_JAVA_HOME_OVERRIDE:-}" ]] && JAVA_CANDIDATES+=("$IDEMPIERE_JAVA_HOME_OVERRIDE")
if [[ "$IDEMPIERE_OS" == "Darwin" ]]; then
  _mac_java_home="$(/usr/libexec/java_home -v "$IDEMPIERE_JAVA_MAJOR_EXPECTED" 2>/dev/null || true)"
  [[ -n "$_mac_java_home" ]] && JAVA_CANDIDATES+=("$_mac_java_home")
else
  JAVA_CANDIDATES+=(
    "/usr/lib/jvm/java-17-openjdk-amd64"
    "/usr/lib/jvm/java-1.17.0-openjdk-amd64"
    "/usr/lib/jvm/openjdk-17"
  )
fi

unset JAVA_HOME
for j in "${JAVA_CANDIDATES[@]}"; do
  [[ -x "$j/bin/java" && -x "$j/bin/javac" ]] || continue
  _java_major="$("$j/bin/javac" -version 2>&1 | awk '{split($2, v, "."); print v[1]}' || true)"
  if [[ "$_java_major" == "$IDEMPIERE_JAVA_MAJOR_EXPECTED" ]]; then
    export JAVA_HOME="$j"
    break
  fi
done
unset _mac_java_home _java_major j

if [[ -z "${JAVA_HOME:-}" ]]; then
  echo "❌ No se encontró Java 17 compatible en $IDEMPIERE_OS."
  if [[ "$IDEMPIERE_OS" == "Darwin" ]]; then
    echo "   Instala un JDK 17 y comprueba: /usr/libexec/java_home -V"
  else
    echo "   Instala en Pop!_OS/Ubuntu con: sudo apt install -y openjdk-17-jdk"
  fi
  return 1 2>/dev/null || exit 1
fi

# --- PATH_add fallback (por si se evalúa fuera de direnv) ---
if ! command -v PATH_add >/dev/null 2>&1; then
  PATH_add() { case ":${PATH:-}:" in *":$1:"*) ;; *) export PATH="$1${PATH:+:$PATH}" ;; esac; }
fi

# --- Estructura mínima del entorno ---
mkdir -p \
  "$MVN_LOCAL_REPO" \
  "$ECLIPSE_WORKSPACE" \
  "$SOURCES_DIR" \
  "$ECLIPSE_P2" \
  "$BIN_DIR"

# --- settings.xml Maven local ---
if [[ ! -f "$MAVEN_USER_SETTINGS" ]]; then
  cat >"$MAVEN_USER_SETTINGS" <<EOF
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <localRepository>$MVN_LOCAL_REPO</localRepository>
</settings>
EOF
fi

# --- Flags Maven comunes ---
# El repositorio se pasa como argumento citado en mvn13, incluso con espacios.
# No modificar MAVEN_OPTS heredado en cada recarga.

# ==============================================================
# Wrappers auxiliares
# ==============================================================

cat > "$BIN_DIR/idempiere-common.sh" <<'EOF'
# LC_ALL takes precedence over LC_MESSAGES and LANG. Other languages use English.
_idem_language() {
  case "${LC_ALL:-${LC_MESSAGES:-${LANG:-C}}}" in
    es|es_*|es.*|es-*) printf '%s' es ;;
    *) printf '%s' en ;;
  esac
}
_idem_text() {
  if [[ "$(_idem_language)" == es ]]; then printf '%s' "$1"; else printf '%s' "$2"; fi
}
_idem_help() {
  local command_name="${1:-idempiere-help}" synopsis description example
  case "$command_name" in
    mvn13)
      synopsis='mvn13 [Maven arguments]'
      description="$(_idem_text 'Compila el core mediante el Maven Wrapper oficial, con JDK y repositorio Maven aislados. Los argumentos restantes se pasan a Maven.' 'Builds core using the official Maven Wrapper, isolated JDK and Maven repository. Remaining arguments are passed to Maven.')"
      example='mvn13 verify' ;;
    eclipse-start)
      synopsis='eclipse-start'
      description="$(_idem_text 'Abre Eclipse local usando JDK 17 y el workspace aislado de este entorno.' 'Starts local Eclipse using JDK 17 and this environment’s isolated workspace.')"
      example='eclipse-start' ;;
    eclipse-choose)
      synopsis='eclipse-choose'
      description="$(_idem_text 'Abre Eclipse con selector de workspace y la configuración P2 local.' 'Starts Eclipse with the workspace chooser and local P2 configuration.')"
      example='eclipse-choose' ;;
    idempiere-root)
      synopsis='idempiere-root'
      description="$(_idem_text 'Abre un nuevo shell en el clon del core. Usa exit para volver al shell anterior.' 'Opens a new shell in the core checkout. Use exit to return to the previous shell.')"
      example='idempiere-root' ;;
    idempiere-clone)
      synopsis='idempiere-clone'
      description="$(_idem_text 'Pregunta si usar el repositorio oficial o un fork, clona release-13 y guarda la configuración Git. Un clon existente sólo se valida; requiere configuración previa. Accede a la red.' 'Asks whether to use the official repository or a fork, clones release-13 and saves Git configuration. An existing checkout is only validated and requires prior configuration. Uses the network.')"
      example='idempiere-clone' ;;
    idempiere-remotes)
      synopsis='idempiere-remotes'
      description="$(_idem_text 'Muestra los remotos Git y sus URLs, sin modificar el repositorio.' 'Displays Git remotes and their URLs without changing the repository.')"
      example='idempiere-remotes' ;;
    idempiere-git-check)
      synopsis='idempiere-git-check'
      description="$(_idem_text 'Valida que origin y upstream coincidan con el modo Git guardado. Devuelve error si son incoherentes.' 'Checks origin and upstream against the saved Git mode. Returns an error if they disagree.')"
      example='idempiere-git-check' ;;
    idempiere-sync-upstream)
      synopsis='idempiere-sync-upstream'
      description="$(_idem_text 'Actualiza release-13 local mediante fast-forward desde upstream (fork) u origin (oficial). Exige release-13 y árbol limpio. Accede a la red; no publica cambios.' 'Updates local release-13 by fast-forward from upstream (fork) or origin (official). Requires release-13 and a clean tree. Uses the network; does not publish changes.')"
      example='idempiere-sync-upstream' ;;
    idempiere-new-feature)
      synopsis="$(_idem_text 'idempiere-new-feature <rama>' 'idempiere-new-feature <branch>')"
      description="$(_idem_text 'Actualiza release-13 y crea una rama desde la referencia remota oficial. Exige árbol limpio. Accede a la red. Usa una rama por ticket para contribuir al core.' 'Updates release-13 and creates a branch from the official remote reference. Requires a clean tree. Uses the network. Use one branch per ticket for core contributions.')"
      example='idempiere-new-feature IDEMPIERE-1234-fix-payment' ;;
    idempiere-doctor)
      synopsis='idempiere-doctor [--network]'
      description="$(_idem_text 'Diagnostica Java, Maven, Eclipse y Git sin modificarlos. --network comprueba además SSH a GitHub. Devuelve error ante fallos bloqueantes; los avisos no causan error.' 'Diagnoses Java, Maven, Eclipse and Git without changing them. --network also checks GitHub SSH. Returns an error for blocking failures; warnings do not cause an error.')"
      example='idempiere-doctor --network' ;;
    idempiere-help)
      synopsis='idempiere-help [command]'
      description="$(_idem_text 'Lista los comandos personalizados o muestra la ayuda de uno. También acepta help, --help o -h en cada comando, y man <comando>.' 'Lists custom commands or displays help for one. Each command also accepts help, --help or -h, and man <command>.')"
      example='idempiere-help mvn13' ;;
    *) printf '%s: %s\n' "$(_idem_text 'Comando desconocido' 'Unknown command')" "$command_name" >&2; return 1 ;;
  esac
  printf '%s\n\n%s: %s\n\n%s\n\n%s: %s\n' "$command_name" \
    "$(_idem_text 'Uso' 'Usage')" "$synopsis" "$description" \
    "$(_idem_text 'Ejemplo' 'Example')" "$example"
  printf '\n%s\n' "$(_idem_text 'Ayuda: help, --help, -h o --man como primer argumento.' 'Help: help, --help, -h or --man as the first argument.')"
  if [[ "$command_name" == idempiere-help ]]; then
    printf '\n%s\n' "$(_idem_text 'Comandos disponibles:' 'Available commands:')"
    printf '  %s\n' mvn13 eclipse-start eclipse-choose idempiere-root idempiere-clone idempiere-remotes idempiere-git-check idempiere-sync-upstream idempiere-new-feature idempiere-doctor idempiere-help
  fi
}
EOF

cat > "$BIN_DIR/idempiere-help" <<'EOF'
#!/bin/bash
set -euo pipefail
source "${BIN_DIR:?}/idempiere-common.sh"
case "${1:-}" in help|--help|-h) _idem_help idempiere-help ;; --man) exec man idempiere-help ;; *) _idem_help "${1:-idempiere-help}" ;; esac
EOF
chmod +x "$BIN_DIR/idempiere-help"

# Generate both manual languages locally, selecting the locale at direnv load.
export IDEMPIERE_MAN_ROOT="$BASE/.local-share/man"
mkdir -p "$IDEMPIERE_MAN_ROOT/es/man1"
cat > "$IDEMPIERE_MAN_ROOT/es/man1/mvn13.1" <<'EOF'
.TH MVN13 1 "2026-10-06" "iDempiere 13" "Comandos locales"
.SH NOMBRE
mvn13
.SH SINOPSIS
mvn13 [Maven arguments]
.SH DESCRIPCIÓN
Compila el core mediante el Maven Wrapper oficial, con JDK y repositorio Maven aislados. Los argumentos restantes se pasan a Maven.
.SH EJEMPLO
mvn13 verify
.SH AYUDA
mvn13 help | mvn13 --help | mvn13 -h
.br
idempiere-help mvn13
EOF
cat > "$IDEMPIERE_MAN_ROOT/es/man1/eclipse-start.1" <<'EOF'
.TH ECLIPSE-START 1 "2026-10-06" "iDempiere 13" "Comandos locales"
.SH NOMBRE
eclipse-start
.SH SINOPSIS
eclipse-start
.SH DESCRIPCIÓN
Abre Eclipse local usando JDK 17 y el workspace aislado de este entorno.
.SH EJEMPLO
eclipse-start
.SH AYUDA
eclipse-start help | eclipse-start --help | eclipse-start -h
.br
idempiere-help eclipse-start
EOF
cat > "$IDEMPIERE_MAN_ROOT/es/man1/eclipse-choose.1" <<'EOF'
.TH ECLIPSE-CHOOSE 1 "2026-10-06" "iDempiere 13" "Comandos locales"
.SH NOMBRE
eclipse-choose
.SH SINOPSIS
eclipse-choose
.SH DESCRIPCIÓN
Abre Eclipse con selector de workspace y la configuración P2 local.
.SH EJEMPLO
eclipse-choose
.SH AYUDA
